import { FilesNavBack, FilesNavForward, FilesNavUp, FilesRefresh, FilesCut, FilesCopy, FilesPaste, FilesRename, FilesDelete } from "files-icons.slint";
import { ListView, ScrollView } from "std-widgets.slint";

// Theme tokens — central place for colors and metrics.
export global Theme {
    out property <color> window-bg: #202328;
    // Raised fill used by the address bar and other inset controls.
    out property <color> surface: #30343b;
    out property <color> surface-alt: #353a42;
    out property <color> surface-hover: #3b414a;
    out property <color> surface-pressed: #454d57;
    // Sidebar is one step above the content background so the shell reads as
    // "navigation chrome" vs. "document area" (Files/Explorer pattern).
    out property <color> sidebar-bg: #202328;
    out property <color> selection: #3a4955;
    out property <color> selection-strong: #435969;
    out property <color> border: #3a3a42;
    out property <color> border-subtle: #414750;
    out property <color> text-primary: #f2f2f4;
    out property <color> text-secondary: #c9c9d1;
    out property <color> text-muted: #98989f;
    out property <color> text-disabled: #63636e;
    out property <color> accent: #7cc6eb;
    out property <color> danger: #e5534b;
    out property <color> content-bg: #292d33;
    out property <color> tabs-bg: #16191d;
    out property <color> shadow: #00000066;
}

export struct Breadcrumb { label: string, path: string }

export struct FileListItem {
    name: string,
    type_name: string,
    size_text: string,
    modified_text: string,
    icon-id: int,
    is-dir: bool,
    selected: bool,
}

export struct DriveItem {
    name: string,
    path: string,
    icon: image,
    // Fraction of the drive in use, 0..1 (0 when unknown).
    usage: float,
    // e.g. "120 GB free of 476 GB"; empty when unknown.
    detail: string,
}

export global AppState {
    in-out property <[Breadcrumb]> breadcrumbs: [];
    in-out property <string> address_path: "";
    in-out property <string> status_text: "Ready";
    in-out property <int> item_count: 0;
    in-out property <int> selected_count: 0;
    in-out property <bool> loading: false;
    in-out property <string> directory-error: "";
    in-out property <string> current-path: "";
    in-out property <[FileListItem]> files: [];
    in-out property <[string]> tabs: [];
    in-out property <[DriveItem]> drives: [];
    in-out property <[image]> icons: [];
    in-out property <int> active_tab: 0;
    in-out property <bool> can_go_back: false;
    in-out property <bool> can_go_forward: false;
    in-out property <bool> can_go_parent: false;

    in-out property <string> home_path: "";
    in-out property <string> desktop_path: "";
    in-out property <string> documents_path: "";
    in-out property <string> downloads_path: "";
    in-out property <image> home_icon;
    in-out property <image> desktop_icon;
    in-out property <image> documents_icon;
    in-out property <image> downloads_icon;

    in-out property <int> sort_column: 0;
    in-out property <bool> sort_ascending: true;

    in-out property <bool> dialog_visible: false;
    in-out property <string> dialog_title: "";
    in-out property <string> dialog_value: "";

    callback request_navigate(string);
    callback request_back();
    callback request_forward();
    callback request_parent();
    callback request_refresh();
    callback request_new_tab();
    callback request_close_tab(int);
    callback request_switch_tab(int);
    callback request_select(int);
    callback request_toggle(int);
    callback request_range(int);
    callback request_select_all();
    callback request_clear_selection();
    callback request_activate(int);
    callback request_new_folder();
    callback request_rename(int);
    callback request_dialog_confirm(string);
    callback request_dialog_cancel();
    callback request_sort(int);
    callback request_context_open_in_new_tab(int);
    // Explorer clipboard integration.
    callback request_copy();
    callback request_cut();
    callback request_paste();
    callback request_delete();
    // Native Windows shell context menu for a row.
    callback request_shell_menu(int);
}

// Layout metrics (single source of truth for the window skeleton).
export global Metrics {
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;
    out property <length> tabs-height: 40px;
    out property <length> toolbar-height: 56px;
    out property <length> statusbar-height: 24px;
    out property <length> sidebar-width: 224px;
    out property <length> actions-height: 48px;
    out property <length> panel-gap: 8px;
    out property <length> header-height: 32px;
    out property <length> row-height: 29px;
    out property <length> icon-size: 18px;
    out property <length> icon-size-sm: 16px;
    out property <length> col-type: 100px;
    out property <length> col-size: 84px;
    out property <length> col-modified: 144px;
}

// TouchArea that additionally reacts to the mouse back/forward buttons
// (XBUTTON1 / XBUTTON2), exactly like the toolbar navigation buttons.
// Slint TouchAreas always grab non-primary button presses, so every
// interactive region uses this component to keep global mouse navigation
// working; a press that nothing grabs bubbles up to the region wrappers.
component NavTouchArea inherits TouchArea {
    pointer-event(event) => {
        if event.kind == PointerEventKind.down && !AppState.dialog_visible {
            if event.button == PointerEventButton.back {
                AppState.request_back();
            } else if event.button == PointerEventButton.forward {
                AppState.request_forward();
            }
        }
    }
}

// --- Vector glyphs (viewbox 16x16 unless noted, self-centering) ------------
// All icons accept a `tint` so disabled states can dim them.

component IconFolderNew inherits Path {
    in property <color> tint: Theme.text-secondary;
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    fill: root.tint;
    commands: "M 1.5 4.4 C 1.5 3.5 2.2 2.8 3.1 2.8 L 6 2.8 L 7.2 4.3 L 12.9 4.3 C 13.8 4.3 14.5 5 14.5 5.9 L 14.5 11.6 C 14.5 12.5 13.8 13.2 12.9 13.2 L 3.1 13.2 C 2.2 13.2 1.5 12.5 1.5 11.6 Z";
}

// Small close glyph for tab chips (viewbox 10x10).
component IconClose inherits Path {
    in property <color> tint: Theme.text-muted;
    width: 12px;
    height: 12px;
    viewbox-width: 10;
    viewbox-height: 10;
    fill: transparent;
    stroke: root.tint;
    stroke-width: 1.3px;
    commands: "M 2 2 L 8 8 M 8 2 L 2 8";
}

// Small plus glyph for the new-tab button (viewbox 10x10).
component IconPlus inherits Path {
    in property <color> tint: Theme.text-secondary;
    width: 14px;
    height: 14px;
    viewbox-width: 10;
    viewbox-height: 10;
    fill: transparent;
    stroke: root.tint;
    stroke-width: 1.4px;
    commands: "M 5 1.5 L 5 8.5 M 1.5 5 L 8.5 5";
}

// Large outline folder for the empty state (viewbox 24x24).
component IconEmptyFolder inherits Path {
    width: 44px;
    height: 44px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: Theme.text-disabled;
    stroke-width: 1.6px;
    commands: "M 3 7.5 C 3 6.4 3.9 5.1 5 5.1 L 8.6 5.1 L 10.8 7.6 L 19 7.6 C 20.1 7.6 21 8.5 21 9.6 L 21 16.5 C 21 17.6 20.1 18.9 19 18.9 L 5 18.9 C 3.9 18.9 3 17.6 3 16.5 Z";
}

// --- Controls --------------------------------------------------------------

// Square 32x32 navigation button (Back / Forward / Up). The glyph is passed
// as a child and must be centered by the caller.
component NavIconButton inherits Rectangle {
    in property <bool> enabled: true;
    callback clicked();

    // Explicit width: without it the toolbar layout stretches the button.
    width: 32px;
    height: 32px;
    border-radius: Metrics.radius-md;
    background: !enabled
        ? transparent
        : (btn-ta.pressed ? Theme.surface-pressed : (btn-ta.has-hover ? Theme.surface-hover : transparent));

    btn-ta := NavTouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    @children
}

// Compact "New Folder" action aligned with the nav buttons.
component ActionButton inherits Rectangle {
    in property <string> label;
    in property <string> shortcut;
    in property <bool> enabled: true;
    in property <bool> show-label: true;
    callback triggered();
    width: show-label ? 88px : 36px; height: 34px;
    border-radius: Metrics.radius-sm;
    background: !enabled ? transparent : (action-ta.pressed ? Theme.surface-pressed : (action-ta.has-hover ? Theme.surface-hover : transparent));
    accessible-role: button;
    accessible-label: label;
    accessible-description: shortcut;
    Text { x: 34px; width: parent.width - 38px; height: parent.height; text: root.label; visible: root.show-label; font-size: 12px; color: root.enabled ? Theme.text-primary : Theme.text-disabled; vertical-alignment: center; }
    action-ta := NavTouchArea { enabled: root.enabled; clicked => { root.triggered(); } }
    @children
}

// Themed single-line text field (address bar, dialogs). Built directly on
// TextInput so the visual language (radius, borders, focus ring) matches the
// rest of Kova instead of the stock widget style.
//
// `quiet` renders the field without a resting border (address bar style);
// `right-inset` reserves space so trailing @children (e.g. the embedded
// refresh button) do not overlap the text.
component InputField inherits Rectangle {
    in property <string> placeholder: "";
    in property <length> font-size: 13px;
    in property <length> right-inset: 10px;
    in property <length> left-inset: 12px;
    in property <bool> quiet: false;
    in property <bool> navigation: false;
    out property <bool> editing: ti.has-focus;
    in-out property <string> text <=> ti.text;
    callback accepted();
    callback cancelled();

    public function focus-field() { ti.focus(); }
    public function select-all-text() { ti.select-all(); }

    forward-focus: ti;
    height: 32px;
    border-radius: Metrics.radius-md;
    background: Theme.surface;
    border-width: 1px;
    border-color: ti.has-focus
        ? Theme.accent
        : (fld-ta.has-hover ? Theme.border-subtle : (root.quiet ? transparent : Theme.border-subtle));

    // Click-to-focus for the padding area around the text. The TextInput on
    // top handles clicks within the text region itself (caret placement,
    // selection).
    fld-ta := TouchArea {
        clicked => { ti.focus(); }
    }

    VerticalLayout {
        padding-left: root.left-inset;
        padding-right: root.right-inset;
        alignment: center;

        ti := TextInput {

            font-size: root.font-size;
            color: root.navigation && !ti.has-focus ? transparent : Theme.text-primary;
            selection-background-color: root.navigation && !ti.has-focus ? transparent : Theme.selection-strong;
            selection-foreground-color: root.navigation && !ti.has-focus ? transparent : Theme.text-primary;
            accepted => { root.accepted(); }
            key-pressed(event) => {
                if root.navigation && event.text == Key.Escape {
                    root.cancelled();
                    accept
                } else { reject }
            }
        }
    }

    Text {
        text: root.placeholder;
        visible: ti.text == "";
        color: Theme.text-disabled;
        font-size: root.font-size;
        x: root.left-inset;
        height: parent.height;
        vertical-alignment: center;
    }

    ContextMenuArea {
        Menu {
            MenuItem { title: "Cut"; activated => { ti.cut(); } }
            MenuItem { title: "Copy"; activated => { ti.copy(); } }
            MenuItem { title: "Paste"; activated => { ti.paste(); } }
            MenuSeparator { }
            MenuItem { title: "Select All"; activated => { ti.select-all(); } }
        }
    }

    @children
}

component SidebarButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <string> target: "";
    in property <bool> selected: false;

    height: 34px;
    border-radius: Metrics.radius-sm;
    background: selected ? Theme.selection : (side-ta.pressed ? Theme.surface-pressed : (side-ta.has-hover ? Theme.surface-hover : transparent));

    Rectangle { x: 2px; y: 9px; width: 3px; height: 16px; border-radius: 1.5px; background: Theme.accent; visible: root.selected; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 7px;
        spacing: Metrics.space-sm;

        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: Metrics.icon-size-sm;
                height: Metrics.icon-size-sm;
                image-rendering: smooth;
            }
        }

        Text {
            text: root.text;
            color: selected ? Theme.text-primary : Theme.text-secondary;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    side-ta := NavTouchArea {
        clicked => { if root.target != "" { AppState.request_navigate(root.target); } }
    }
}

// Drive entry: icon + name/free-space line over a full-width usage bar. The
// detail text keeps its preferred width (the name elides first) so free-space
// information is not cut off early, and the bar aligns with the text column.
component DriveRow inherits Rectangle {
    in property <DriveItem> drive;

    height: 60px;
    border-radius: Metrics.radius-md;
    background: AppState.current-path == drive.path ? Theme.selection : (drive-ta.pressed ? Theme.surface-pressed : (drive-ta.has-hover ? Theme.surface-hover : transparent));

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 10px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Image {
                source: drive.icon;
                width: 20px;
                height: 20px;
                image-rendering: smooth;
            }
        }

        VerticalLayout {
            spacing: 4px;
            padding-top: 7px;
            padding-bottom: 7px;
            horizontal-stretch: 1;

                Text {
                    text: drive.name;
                    color: Theme.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Text {
                    text: drive.detail;
                    color: Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                    visible: drive.detail != "";
                }
            Rectangle {
                height: 5px;
                border-radius: 2px;
                background: Theme.surface-pressed;
                visible: drive.detail != "";

                Rectangle {
                    x: 0;
                    y: 0;
                    height: parent.height;
                    width: parent.width * Math.clamp(drive.usage, 0, 1);
                    border-radius: 2px;
                    background: drive.usage > 0.9 ? Theme.danger : Theme.accent;
                }
            }
        }
    }

    drive-ta := NavTouchArea {
        clicked => { if drive.path != "" { AppState.request_navigate(drive.path); } }
    }
}

component SectionLabel inherits Text {
    height: 20px;
    color: Theme.text-muted;
    font-size: 11px;
    font-weight: 600;
    vertical-alignment: center;
}

component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <int> column;
    in property <length> text-indent: 8px;
    in property <bool> right-align: false;

    height: 100%;
    background: header-ta.pressed ? Theme.surface-pressed : (header-ta.has-hover ? Theme.surface-hover : transparent);

    HorizontalLayout {
        padding-left: root.right-align ? 0 : root.text-indent;
        padding-right: root.right-align ? 0px : 6px;
        spacing: 4px;
        // Right-aligned columns (Size) push label and arrow to the edge so
        // they line up with the right-aligned cell values.
        alignment: root.right-align ? end : start;

        Text {
            text: root.text;
            color: AppState.sort_column == root.column ? Theme.text-primary : Theme.text-muted;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: AppState.sort_column == root.column ? (AppState.sort_ascending ? "▲" : "▼") : "";
            color: Theme.accent;
            font-size: 9px;
            vertical-alignment: center;
        }
    }

    header-ta := NavTouchArea {
        clicked => { AppState.request_sort(root.column); }
    }
}

component NameDialog inherits Rectangle {
    in-out property <string> title <=> AppState.dialog_title;
    visible: AppState.dialog_visible;
    background: #000000aa;
    TouchArea {}

    Rectangle {
        width: 420px;
        height: root.title == "Error" ? 236px : 184px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface-alt;
        border-radius: Metrics.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 20px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 6px;

        Text {
            x: 24px; y: 20px; width: 372px; height: 24px;
            text: root.title;
            color: root.title == "Error" ? Theme.danger : Theme.text-primary;
            font-size: 14px; font-weight: 600;
        }

        dialog-scope := FocusScope {
            x: 24px; y: 60px; width: 372px;
            height: root.title == "Error" ? 104px : 36px;
            key-pressed(event) => {
                if event.text == Key.Escape || (event.text == Key.Return && root.title == "Error") {
                    AppState.request_dialog_cancel();
                    accept
                } else { reject }
            }
            name-input := InputField {
                x: 0; y: 0; width: 372px; height: 36px;
                visible: root.title != "Error";
                font-size: 13px;
                text <=> AppState.dialog_value;
                accepted => { AppState.request_dialog_confirm(AppState.dialog_value); }
            }
            Text {
                x: 0; y: 0; width: 372px; height: 104px;
                visible: root.title == "Error";
                text: AppState.dialog_value;
                color: Theme.text-secondary;
                font-size: 12px;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        Rectangle {
            x: 220px; y: parent.height - 54px; width: 84px; height: 30px;
            visible: root.title != "Error";
            background: cancel-ta.pressed ? Theme.surface-pressed : Theme.surface-hover;
            border-radius: Metrics.radius-md;
            Text { text: "Cancel"; color: Theme.text-primary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
            cancel-ta := TouchArea { clicked => { AppState.request_dialog_cancel(); } }
        }
        Rectangle {
            x: 312px; y: parent.height - 54px; width: 84px; height: 30px;
            background: ok-ta.pressed ? Theme.text-secondary : Theme.accent;
            border-radius: Metrics.radius-md;
            Text { text: root.title == "Error" ? "Close" : (root.title == "Rename" ? "Rename" : "Create"); color: Theme.window-bg; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            ok-ta := TouchArea { clicked => { AppState.request_dialog_confirm(AppState.dialog_value); } }
        }
    }
    changed visible => {
        if self.visible {
            if root.title == "Error" { dialog-scope.focus(); }
            else { name-input.focus-field(); name-input.select-all-text(); }
        }
    }
}
export component MainWindow inherits Window {
    title: "Kova";
    no-frame: true;
    resize-border-width: 5px;
    callback window-action(int);
    in-out property <bool> window-maximized: false;
    property <length> tab-width: Math.min(198px, Math.max(140px, (root.width - Metrics.sidebar-width - 202px) / Math.max(1, AppState.tabs.length) - 4px));
    min-width: 760px;
    min-height: 500px;
    preferred-width: 1120px;
    preferred-height: 740px;
    default-font-family: "Segoe UI";
    background: Theme.window-bg;
    forward-focus: list-scope;

    // Window skeleton — absolute placement against the window, so every
    // region has a well-defined, non-negotiable geometry. Tabs and toolbar
    // share the window background and read as one chrome block; a single
    // hairline below the toolbar separates chrome from content.

    tabs := Rectangle {
        y: 0;
        x: 0;
        width: parent.width;
        height: Metrics.tabs-height;
        background: Theme.tabs-bg;

        tabs-nav := NavTouchArea {
            property <bool> dragging: false;
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    self.dragging = false;
                }
            }
            moved => {
                if self.pressed && !self.dragging && (Math.abs(self.mouse-x - self.pressed-x) > 4px || Math.abs(self.mouse-y - self.pressed-y) > 4px) {
                    self.dragging = true;
                    root.window-action(0);
                }
            }
            double-clicked => { root.window-action(2); }
        }

        Text {
            x: 20px; y: 0; width: 140px; height: parent.height;
            text: "KOVA"; font-size: 12px; font-weight: 700;
            color: Theme.accent; vertical-alignment: center;
        }

        tab-scroll := ScrollView {
            x: Metrics.sidebar-width;
            width: Math.min(AppState.tabs.length * (root.tab-width + 4px) + 12px, parent.width - Metrics.sidebar-width - 190px);
            height: parent.height;
            viewport-width: Math.max(self.width, AppState.tabs.length * (root.tab-width + 4px) + 12px);
            viewport-height: self.height;
            HorizontalLayout {
                width: tab-scroll.viewport-width;
                height: Metrics.tabs-height;
                padding: Metrics.space-xs;
                padding-left: 6px;
                spacing: 4px;
                alignment: start;
            for item[idx] in AppState.tabs: Rectangle {
                width: root.tab-width;
                height: 36px;
                border-radius: Metrics.radius-md;
                background: idx == AppState.active_tab ? Theme.window-bg : (tab-ta.pressed ? Theme.surface-pressed : (tab-ta.has-hover ? Theme.surface-hover : transparent));

                tab-ta := NavTouchArea {
                    clicked => { AppState.request_switch_tab(idx); }
                }

                Rectangle {
                    y: parent.height - 7px; height: 7px; width: parent.width;
                    background: Theme.window-bg; visible: idx == AppState.active_tab;
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 3px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: center;
                        IconFolderNew { width: 15px; height: 15px; tint: idx == AppState.active_tab ? Theme.accent : Theme.text-muted; }
                    }
                    Text {
                        text: item;
                        color: idx == AppState.active_tab ? Theme.text-primary : Theme.text-secondary;
                        font-size: 12px;
                        font-weight: idx == AppState.active_tab ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 4px;
                            background: close-ta.has-hover ? Theme.surface-hover : transparent;
                            visible: AppState.tabs.length > 1;

                            IconClose {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                tint: close-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                            }

                            close-ta := NavTouchArea {
                                clicked => { AppState.request_close_tab(idx); }
                            }
                        }
                    }
                }
            }

            }
        }
        Rectangle {
            x: tab-scroll.x + tab-scroll.width + 2px;
            y: 4px;
            width: 28px;
            height: 30px;
            border-radius: Metrics.radius-md;
            background: new-tab-ta.pressed ? Theme.surface-pressed : (new-tab-ta.has-hover ? Theme.surface-hover : transparent);
            IconPlus { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            new-tab-ta := NavTouchArea { clicked => { AppState.request_new_tab(); } }
        }
        HorizontalLayout {
            x: parent.width - 138px; y: 0; width: 138px; height: parent.height;
            spacing: 0px;
            Rectangle {
                width: 46px; background: min-ta.has-hover ? Theme.surface-hover : transparent;
                accessible-role: button; accessible-label: "Minimize";
                Rectangle { x: 18px; y: 20px; width: 10px; height: 1px; background: Theme.text-secondary; }
                min-ta := TouchArea { clicked => { root.window-action(1); } }
            }
            Rectangle {
                width: 46px; background: max-ta.has-hover ? Theme.surface-hover : transparent;
                accessible-role: button; accessible-label: root.window-maximized ? "Restore" : "Maximize";
                Rectangle { x: 19px; y: 13px; width: 9px; height: 9px; background: transparent; border-width: 1px; border-color: Theme.text-secondary; visible: root.window-maximized; }
                Rectangle { x: 17px; y: 15px; width: 10px; height: 10px; background: max-ta.has-hover ? Theme.surface-hover : Theme.tabs-bg; border-width: 1px; border-color: Theme.text-secondary; }
                max-ta := TouchArea { clicked => { root.window-action(2); } }
            }
            Rectangle {
                width: 46px; background: exit-ta.has-hover ? #c42b3b : transparent;
                accessible-role: button; accessible-label: "Close window";
                IconClose { x: 18px; y: 15px; tint: exit-ta.has-hover ? #ffffff : Theme.text-secondary; }
                exit-ta := TouchArea { clicked => { root.window-action(3); } }
            }
        }
    }
    toolbar := Rectangle {
        y: Metrics.tabs-height;
        x: 0;
        width: parent.width;
        height: Metrics.toolbar-height;
        background: Theme.window-bg;

        toolbar-nav := NavTouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
        }

        HorizontalLayout {
            width: parent.width; height: parent.height;
            padding: 8px; spacing: 6px;
            NavIconButton { enabled: AppState.can_go_back; clicked => { AppState.request_back(); } FilesNavBack { tint: parent.enabled ? Theme.text-primary : Theme.text-disabled; x: 7px; y: 7px; } }
            NavIconButton { enabled: AppState.can_go_forward; clicked => { AppState.request_forward(); } FilesNavForward { tint: parent.enabled ? Theme.text-primary : Theme.text-disabled; x: 7px; y: 7px; } }
            NavIconButton { enabled: AppState.can_go_parent; clicked => { AppState.request_parent(); } FilesNavUp { tint: parent.enabled ? Theme.text-primary : Theme.text-disabled; x: 7px; y: 7px; } }
            NavIconButton { clicked => { AppState.request_refresh(); } FilesRefresh { x: 7px; y: 7px; } }
            address-field := InputField {
                height: 38px; horizontal-stretch: 1;
                border-radius: Metrics.radius-lg;
                left-inset: 38px;
                navigation: true;
                text <=> AppState.address_path;
                accepted => { AppState.request_navigate(AppState.address_path); list-scope.focus(); }
                cancelled => { AppState.address_path = AppState.current-path; list-scope.focus(); }
                HorizontalLayout {
                    x: 36px; y: 4px; width: parent.width - 48px; height: 30px;
                    visible: !address-field.editing;
                    alignment: start; spacing: 2px;
                    for crumb[index] in AppState.breadcrumbs: Rectangle {
                        width: Math.min(156px, (address-field.width - 54px) / Math.max(1, AppState.breadcrumbs.length));
                        height: 30px;
                        border-radius: Metrics.radius-sm;
                        background: crumb-ta.has-hover ? Theme.surface-hover : transparent;
                        Text { x: 8px; width: parent.width - 26px; height: parent.height; text: crumb.label; font-size: 13px; color: index == AppState.breadcrumbs.length - 1 ? Theme.text-primary : Theme.text-secondary; vertical-alignment: center; overflow: elide; }
                        Path { x: parent.width - 12px; y: 11px; width: 5px; height: 8px; viewbox-width: 5; viewbox-height: 8; fill: transparent; stroke: Theme.text-muted; stroke-width: 1px; commands: "M 1 1 L 4 4 L 1 7"; visible: index < AppState.breadcrumbs.length - 1; }
                        crumb-ta := NavTouchArea { clicked => { AppState.request_navigate(crumb.path); list-scope.focus(); } }
                    }
                }
                IconFolderNew { x: 13px; y: 11px; tint: Theme.accent; }
            }
        }
    }

    // Content zone.
    content := Rectangle {
        y: Metrics.tabs-height + Metrics.toolbar-height;
        x: 0;
        width: parent.width;
        height: parent.height - Metrics.tabs-height - Metrics.toolbar-height - Metrics.statusbar-height;

        // Sidebar.
        sidebar := Rectangle {
            x: 0;
            y: 0;
            width: Metrics.sidebar-width;
            height: parent.height;
            background: Theme.sidebar-bg;

            sidebar-nav := NavTouchArea {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
            }

            sidebar-scroll := ScrollView {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: Math.max(self.height, 238px + AppState.drives.length * 61px);
            VerticalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                height: sidebar-scroll.viewport-height;
                padding: Metrics.space-sm;
                padding-top: 10px;
                spacing: 1px;
                alignment: start;

                SidebarButton { text: "Home"; icon: AppState.home_icon; target: AppState.home_path; selected: AppState.current-path == AppState.home_path; }
                Rectangle { height: 12px; }
                SectionLabel { text: "Quick access"; }
                SidebarButton { text: "Desktop"; icon: AppState.desktop_icon; target: AppState.desktop_path; selected: AppState.current-path == AppState.desktop_path; }
                SidebarButton { text: "Documents"; icon: AppState.documents_icon; target: AppState.documents_path; selected: AppState.current-path == AppState.documents_path; }
                SidebarButton { text: "Downloads"; icon: AppState.downloads_icon; target: AppState.downloads_path; selected: AppState.current-path == AppState.downloads_path; }

                Rectangle { height: 10px; }

                SectionLabel { text: "Devices & drives"; }
                for drive in AppState.drives: DriveRow { drive: drive; }
            }

            }

        }

        actionbar := Rectangle {
            x: Metrics.sidebar-width; y: 0;
            width: parent.width - Metrics.sidebar-width - Metrics.space-sm;
            height: Metrics.actions-height;
            background: Theme.surface;
            border-radius: Metrics.radius-lg;
            border-width: 1px; border-color: Theme.border-subtle;
            HorizontalLayout {
                padding: 7px; spacing: 4px;
                ActionButton { label: "New folder"; shortcut: ""; width: 108px; enabled: !AppState.loading && AppState.directory-error == ""; triggered => { list-scope.focus(); AppState.request_new_folder(); } IconFolderNew { x: 10px; y: 9px; tint: parent.enabled ? Theme.accent : Theme.text-disabled; } }
                Rectangle { width: 1px; background: Theme.border-subtle; }
                ActionButton { label: "Cut"; shortcut: "Ctrl+X"; show-label: root.width >= 1000px; enabled: AppState.selected_count > 0; triggered => { list-scope.focus(); AppState.request_cut(); } FilesCut { x: 9px; y: 8px; tint: parent.enabled ? Theme.text-secondary : Theme.text-disabled; accent: parent.enabled ? Theme.accent : Theme.text-disabled; } }
                ActionButton { label: "Copy"; shortcut: "Ctrl+C"; show-label: root.width >= 1000px; enabled: AppState.selected_count > 0; triggered => { list-scope.focus(); AppState.request_copy(); } FilesCopy { x: 9px; y: 8px; tint: parent.enabled ? Theme.text-secondary : Theme.text-disabled; accent: parent.enabled ? Theme.accent : Theme.text-disabled; } }
                ActionButton { label: "Paste"; shortcut: "Ctrl+V"; show-label: root.width >= 1000px; enabled: !AppState.loading && AppState.directory-error == ""; triggered => { list-scope.focus(); AppState.request_paste(); } FilesPaste { x: 9px; y: 8px; tint: parent.enabled ? Theme.text-secondary : Theme.text-disabled; accent: parent.enabled ? Theme.accent : Theme.text-disabled; } }
                ActionButton { label: "Rename"; shortcut: "F2"; show-label: root.width >= 1000px; enabled: AppState.selected_count == 1; triggered => { list-scope.focus(); AppState.request_rename(-1); } FilesRename { x: 9px; y: 8px; tint: parent.enabled ? Theme.text-secondary : Theme.text-disabled; accent: parent.enabled ? Theme.accent : Theme.text-disabled; } }
                ActionButton { label: "Delete"; shortcut: "Del"; show-label: root.width >= 1000px; enabled: AppState.selected_count > 0; triggered => { list-scope.focus(); AppState.request_delete(); } FilesDelete { x: 9px; y: 8px; tint: parent.enabled ? Theme.text-secondary : Theme.text-disabled; accent: parent.enabled ? Theme.accent : Theme.text-disabled; } }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Details"; visible: root.width >= 1100px; font-size: 12px; color: Theme.text-muted; vertical-alignment: center; }
            }
        }

        // File list column.
        file-list := Rectangle {
            x: Metrics.sidebar-width;
            y: Metrics.actions-height + Metrics.panel-gap;
            width: parent.width - Metrics.sidebar-width - Metrics.space-sm;
            height: parent.height - Metrics.actions-height - Metrics.panel-gap;
            background: Theme.content-bg;
            border-radius: Metrics.radius-lg;
            border-width: 1px; border-color: Theme.border-subtle;
            clip: true;

            // Catches mouse back/forward and empty-area clicks for the whole
            // file column; interactive children grab their events first.
            list-nav := NavTouchArea {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                clicked => {
                    if !AppState.dialog_visible {
                        AppState.request_clear_selection();
                    }
                }
            }

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: Metrics.header-height;
                background: Theme.content-bg;

                header := HorizontalLayout {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    spacing: 6px;
                    padding-right: 16px;
                    HeaderCell { text: "Name"; column: 0; horizontal-stretch: 1; min-width: 140px; text-indent: 32px; }
                    HeaderCell { text: "Type"; column: 1; width: Metrics.col-type; text-indent: 0px; }
                    HeaderCell { text: "Size"; column: 2; width: Metrics.col-size; text-indent: 0px; right-align: true; }
                    HeaderCell { text: "Modified"; column: 3; width: Metrics.col-modified; text-indent: 0px; }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: parent.width;
                    background: Theme.border-subtle;
                }
            }

            // Context menu for the empty list area. Right clicks over rows
            // never reach this menu because the row TouchAreas grab the
            // press first; those rows open the native shell menu instead.
            empty-area-menu := ContextMenuArea {
                x: 0;
                y: Metrics.header-height;
                width: parent.width;
                height: parent.height - Metrics.header-height;

                Menu {
                    MenuItem {
                        title: "New Folder";
                        activated => { AppState.request_new_folder(); }
                    }
                    MenuItem {
                        title: "Paste";
                        activated => { AppState.request_paste(); }
                    }
                    MenuSeparator { }
                    MenuItem {
                        title: "Refresh";
                        activated => { AppState.request_refresh(); }
                    }
                }

                list-scope := FocusScope {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;

                    key-pressed(event) => {
                        if event.text == "a" && event.modifiers.control {
                            AppState.request_select_all();
                            accept
                        } else if event.text == Key.F5 {
                            AppState.request_refresh();
                            accept
                        } else if event.text == Key.F2 {
                            AppState.request_rename(-1);
                            accept
                        } else if event.text == Key.Return {
                            AppState.request_activate(-1);
                            accept
                        } else if event.text == Key.Delete {
                            AppState.request_delete();
                            accept
                        } else if event.text == "c" && event.modifiers.control {
                            AppState.request_copy();
                            accept
                        } else if event.text == "x" && event.modifiers.control {
                            AppState.request_cut();
                            accept
                        } else if event.text == "v" && event.modifiers.control {
                            AppState.request_paste();
                            accept
                        } else if event.text == "t" && event.modifiers.control {
                            AppState.request_context_open_in_new_tab(-1);
                            accept
                        } else if event.text == Key.Escape {
                            AppState.request_clear_selection();
                            accept
                        } else if event.text == Key.LeftArrow && event.modifiers.alt {
                            AppState.request_back();
                            accept
                        } else if event.text == Key.RightArrow && event.modifiers.alt {
                            AppState.request_forward();
                            accept
                        } else if event.text == Key.UpArrow && event.modifiers.alt {
                            AppState.request_parent();
                            accept
                        } else if event.text == "l" && event.modifiers.control {
                            // Standard "focus address bar" shortcut (browser /
                            // Explorer behavior): focus + select all, so typing
                            // replaces the current path.
                            address-field.focus-field();
                            address-field.select-all-text();
                            accept
                        } else {
                            reject
                        }
                    }

                    ListView {
                        width: parent.width;
                        height: parent.height;

                        for item[idx] in AppState.files: Rectangle {
                            height: Metrics.row-height;

                            // Rounded hover/selection pill inset from the row
                            // edges — the modern Files/OneDrive look. The
                            // hit target stays the full row.
                            row-pill := Rectangle {
                                x: 4px;
                                y: 1px;
                                width: parent.width - 8px;
                                height: parent.height - 2px;
                                border-radius: Metrics.radius-sm;
                                border-width: item.selected ? 1px : 0px;
                                border-color: list-scope.has-focus ? #5485a3 : Theme.border-subtle;
                                background: item.selected
                                    ? (row-ta.has-hover ? Theme.selection-strong : Theme.selection)
                                    : (row-ta.pressed ? Theme.surface-pressed : (row-ta.has-hover ? Theme.surface-hover : transparent));
                            }

                            HorizontalLayout {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                padding-left: 8px;
                                padding-right: 16px;
                                spacing: 6px;

                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: AppState.icons[item.icon-id];
                                        width: Metrics.icon-size;
                                        height: Metrics.icon-size;
                                        image-rendering: smooth;
                                    }
                                }

                                Text {
                                    text: item.name;
                                    color: item.selected
                                        ? Theme.text-primary
                                        : Theme.text-primary;
                                    font-size: 13px;
                                    min-width: 108px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text { text: item.type_name; color: item.selected ? Theme.text-secondary : Theme.text-muted; font-size: 12px; width: Metrics.col-type; vertical-alignment: center; overflow: elide; }
                                Text { text: item.size_text; color: item.selected ? Theme.text-secondary : Theme.text-muted; font-size: 12px; width: Metrics.col-size; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                Text { text: item.modified_text; color: item.selected ? Theme.text-secondary : Theme.text-muted; font-size: 12px; width: Metrics.col-modified; vertical-alignment: center; overflow: elide; }
                            }

                            row-ta := TouchArea {
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down && !AppState.dialog_visible {
                                        // Keep keyboard focus on the list scope so
                                        // F2/F5/Enter/Ctrl+A keep working after clicks.
                                        list-scope.focus();
                                        if event.button == PointerEventButton.back {
                                            AppState.request_back();
                                        } else if event.button == PointerEventButton.forward {
                                            AppState.request_forward();
                                        } else if event.button == PointerEventButton.right {
                                            // Right click selects unselected items;
                                            // multi-selections are preserved. The
                                            // native shell menu opens for the
                                            // (possibly multi-) selection.
                                            if !item.selected {
                                                AppState.request_select(idx);
                                            }
                                            AppState.request_shell_menu(idx);
                                        } else if event.modifiers.control {
                                            AppState.request_toggle(idx);
                                        } else if event.modifiers.shift {
                                            AppState.request_range(idx);
                                        } else {
                                            AppState.request_select(idx);
                                        }
                                    }
                                }
                                double-clicked => { AppState.request_activate(idx); }
                            }
                        }
                    }

                    // Empty and loading states, centered in the content area.
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        visible: AppState.files.length == 0;

                        VerticalLayout {
                            width: parent.width;
                            y: parent.height / 2 - 54px;
                            height: 108px;
                            spacing: Metrics.space-sm;
                            alignment: start;

                            Rectangle {
                                height: AppState.loading ? 0px : 44px;
                                visible: !AppState.loading;
                                IconEmptyFolder {
                                    width: 44px; height: 44px;
                                    x: (parent.width - self.width) / 2;
                                }
                            }

                            Text {
                                text: AppState.loading ? "Loading…" : (AppState.directory-error != "" ? "Can't open this folder" : "This folder is empty");
                                color: AppState.loading ? Theme.text-secondary : Theme.text-primary;
                                font-size: 13px;
                                font-weight: AppState.loading ? 400 : 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: 22px;
                            }

                            Text {
                                text: AppState.directory-error != "" ? AppState.directory-error : "Create a folder or paste files to get started.";
                                overflow: elide;
                                color: Theme.text-muted;
                                font-size: 11.5px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: 18px;
                                visible: !AppState.loading;
                            }
                        }
                    }
                }
            }
        }
    }

    // Status bar — full width, pinned to the bottom, same background as the
    // window so it stays visually quiet.
    statusbar := Rectangle {
        y: parent.height - Metrics.statusbar-height;
        x: 0;
        width: parent.width;
        height: Metrics.statusbar-height;
        background: Theme.window-bg;

        statusbar-nav := NavTouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
        }

        // Hairline separating the status bar from the content.
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 1px;
            background: Theme.border-subtle;
        }

        HorizontalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            padding-left: Metrics.sidebar-width + 8px;
            padding-right: 12px;
            spacing: Metrics.space-sm;

            Text {
                text: AppState.status_text;
                color: Theme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            Text {
                text: AppState.selected_count > 0
                    ? AppState.selected_count + " of " + AppState.item_count + " selected"
                    : AppState.item_count + " items";
                color: AppState.selected_count > 0 ? Theme.text-secondary : Theme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }

    NameDialog { changed visible => { if !self.visible { list-scope.focus(); } } }
}

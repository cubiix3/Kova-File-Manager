// Layout metrics (single source of truth for the window skeleton).
export global Metrics {
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;
    out property <length> tabs-height: 44px;
    out property <length> toolbar-height: 48px;
    out property <length> statusbar-height: 34px;
    out property <length> sidebar-width: 224px;
    out property <length> sidebar-item-height: 36px;
    out property <length> sidebar-drive-height: 72px;
    out property <length> actions-height: 48px;
    out property <length> panel-gap: 0px;
    out property <length> header-height: 34px;
    out property <length> row-height: AppState.compact-rows ? 34px : 40px;
    out property <length> icon-size: 20px;
    out property <length> icon-size-sm: 16px;
    out property <length> col-type: 108px;
    out property <length> col-size: 88px;
    out property <length> col-modified: 146px;
}

// TouchArea that additionally reacts to the mouse back/forward buttons
// (XBUTTON1 / XBUTTON2), exactly like the toolbar navigation buttons.
// Slint TouchAreas always grab non-primary button presses, so every
// interactive region uses this component to keep global mouse navigation
// working; a press that nothing grabs bubbles up to the region wrappers.
component NavTouchArea inherits TouchArea {
    pointer-event(event) => {
        if event.kind == PointerEventKind.down && !AppState.dialog_visible {
            if event.button == PointerEventButton.back {
                AppState.request_back();
            } else if event.button == PointerEventButton.forward {
                AppState.request_forward();
            }
        }
    }
}

// --- Vector glyphs (viewbox 16x16 unless noted, self-centering) ------------
// All icons accept a `tint` so disabled states can dim them.

component IconFolderNew inherits Path {
    in property <color> tint: Theme.text-secondary;
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    fill: root.tint;
    commands: "M 1.5 4.4 C 1.5 3.5 2.2 2.8 3.1 2.8 L 6 2.8 L 7.2 4.3 L 12.9 4.3 C 13.8 4.3 14.5 5 14.5 5.9 L 14.5 11.6 C 14.5 12.5 13.8 13.2 12.9 13.2 L 3.1 13.2 C 2.2 13.2 1.5 12.5 1.5 11.6 Z";
}

// Small close glyph for tab chips (viewbox 10x10).
component IconClose inherits Path {
    in property <color> tint: Theme.text-muted;
    width: 12px;
    height: 12px;
    viewbox-width: 10;
    viewbox-height: 10;
    fill: transparent;
    stroke: root.tint;
    stroke-width: 1.3px;
    commands: "M 2 2 L 8 8 M 8 2 L 2 8";
}

// Small plus glyph for the new-tab button (viewbox 10x10).
component IconPlus inherits Path {
    in property <color> tint: Theme.text-secondary;
    width: 14px;
    height: 14px;
    viewbox-width: 10;
    viewbox-height: 10;
    fill: transparent;
    stroke: root.tint;
    stroke-width: 1.4px;
    commands: "M 5 1.5 L 5 8.5 M 1.5 5 L 8.5 5";
}

// Large outline folder for the empty state (viewbox 24x24).
component IconEmptyFolder inherits Path {
    width: 44px;
    height: 44px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: Theme.text-disabled;
    stroke-width: 1.6px;
    commands: "M 3 7.5 C 3 6.4 3.9 5.1 5 5.1 L 8.6 5.1 L 10.8 7.6 L 19 7.6 C 20.1 7.6 21 8.5 21 9.6 L 21 16.5 C 21 17.6 20.1 18.9 19 18.9 L 5 18.9 C 3.9 18.9 3 17.6 3 16.5 Z";
}

// --- Controls --------------------------------------------------------------

// Square 32x32 navigation button (Back / Forward / Up). The glyph is passed
// as a child and must be centered by the caller.
component NavIconButton inherits Rectangle {
    in property <bool> enabled: true;
    callback clicked();

    // Explicit width: without it the toolbar layout stretches the button.
    width: 32px;
    height: 32px;
    border-radius: Metrics.radius-md;
    background: !enabled
        ? transparent
        : (btn-ta.pressed ? Theme.surface-pressed : (btn-ta.has-hover ? Theme.surface-hover : transparent));

    btn-ta := NavTouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    @children
}

// Compact "New Folder" action aligned with the nav buttons.
component ActionButton inherits Rectangle {
    in property <string> label;
    in property <string> shortcut;
    in property <bool> enabled: true;
    in property <bool> show-label: true;
    callback triggered();
    width: show-label ? 96px : 36px; height: 34px;
    border-radius: Metrics.radius-sm;
    background: !enabled ? transparent : (action-ta.pressed ? Theme.surface-pressed : (action-ta.has-hover ? Theme.surface-hover : transparent));
    accessible-role: button;
    accessible-label: label;
    accessible-description: shortcut;
    Text { x: 34px; width: parent.width - 38px; height: parent.height; text: root.label; visible: root.show-label; font-size: 12px; color: root.enabled ? Theme.text-primary : Theme.text-disabled; vertical-alignment: center; }
    action-ta := NavTouchArea { enabled: root.enabled; clicked => { root.triggered(); } }
    @children
}

// Themed single-line text field (address bar, dialogs). Built directly on
// TextInput so the visual language (radius, borders, focus ring) matches the
// rest of Kova instead of the stock widget style.
//
// `quiet` renders the field without a resting border (address bar style);
// `right-inset` reserves space so trailing @children (e.g. the embedded
// refresh button) do not overlap the text.
component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> accent: false;
    callback clicked();
    forward-focus: button-focus;
    width: 104px; height: 32px; border-radius: 5px;
    background: touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-hover : root.accent ? Theme.selection : Theme.surface;
    border-width: 1px; border-color: root.accent ? Theme.accent.with-alpha(0.4) : Theme.border-subtle;
    Text { text: root.text; color: !root.enabled ? Theme.text-disabled : root.accent ? Theme.accent : Theme.text-primary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    button-focus := FocusScope { key-pressed(event) => { if root.enabled && (event.text == Key.Return || event.text == " ") { root.clicked(); accept } else { reject } } }
    touch := NavTouchArea { enabled: root.enabled; clicked => { button-focus.focus(); root.clicked(); } }
    accessible-role: button; accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
}

component InputField inherits Rectangle {
    in property <string> placeholder: "";
    in property <length> font-size: 13px;
    in property <length> right-inset: 10px;
    in property <length> left-inset: 12px;
    in property <bool> quiet: false;
    in property <bool> navigation: false;
    in property <bool> inline-mode: false;
    out property <bool> editing: ti.has-focus;
    in-out property <string> text <=> ti.text;
    callback accepted();
    callback cancelled();
    callback edited(string);

    public function focus-field() { ti.focus(); }
    public function select-all-text() { ti.select-all(); }
    public function focus-name(end: int) { ti.focus(); ti.set-selection-offsets(0, end); }

    forward-focus: ti;
    height: 32px;
    border-radius: Metrics.radius-md;
    background: Theme.surface;
    border-width: 1px;
    border-color: ti.has-focus
        ? Theme.accent
        : (fld-ta.has-hover ? Theme.border-subtle : (root.quiet ? transparent : Theme.border-subtle));

    // Click-to-focus for the padding area around the text. The TextInput on
    // top handles clicks within the text region itself (caret placement,
    // selection).
    fld-ta := TouchArea {
        clicked => { ti.focus(); }
    }

    VerticalLayout {
        padding-left: root.left-inset;
        padding-right: root.right-inset;
        alignment: center;

        ti := TextInput {

            font-size: root.font-size;
            color: root.navigation && !ti.has-focus ? transparent : Theme.text-primary;
            selection-background-color: root.navigation && !ti.has-focus ? transparent : Theme.selection-strong;
            selection-foreground-color: root.navigation && !ti.has-focus ? transparent : Theme.text-primary;
            accepted => { root.accepted(); }
            edited => { root.edited(self.text); }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.cancelled();
                    accept
                } else { reject }
            }
        }
    }

    Text {
        text: root.placeholder;
        visible: ti.text == "";
        color: Theme.text-disabled;
        font-size: root.font-size;
        x: root.left-inset;
        height: parent.height;
        vertical-alignment: center;
    }

    ContextMenuArea {
        Menu {
            MenuItem { title: "Cut"; activated => { ti.cut(); } }
            MenuItem { title: "Copy"; activated => { ti.copy(); } }
            MenuItem { title: "Paste"; activated => { ti.paste(); } }
            MenuSeparator { }
            MenuItem { title: "Select All"; activated => { ti.select-all(); } }
        }
    }

    @children
}

component IconHome inherits Path {
    in property <color> tint: Theme.text-secondary;
    width: 18px; height: 18px;
    viewbox-width: 20; viewbox-height: 20;
    fill: transparent; stroke: root.tint; stroke-width: 1.5px;
    commands: "M 2 9 L 10 2.5 L 18 9 M 4 7.5 L 4 17 L 8 17 L 8 11 L 12 11 L 12 17 L 16 17 L 16 7.5";
}

component SidebarButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <string> target: "";
    in property <bool> selected: false;
    in property <bool> home: false;
    in property <bool> collection: false;
    in property <int> count: -1;
    in property <color> base-background: transparent;

    height: Metrics.sidebar-item-height;
    animate background { duration: AppState.animations ? 120ms : 0ms; }
    border-radius: Metrics.radius-md;
    background: selected ? Theme.sidebar-selected : (side-ta.pressed ? Theme.surface-pressed : (side-ta.has-hover ? Theme.sidebar-hover : root.base-background));

    Rectangle { x: 0; y: (parent.height - 14px) / 2; width: 3px; height: 14px; border-radius: 1.5px; background: Theme.accent; visible: root.selected; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: Metrics.space-sm;

        VerticalLayout {
            width: 18px;
            alignment: center;
            if root.home: IconHome { tint: root.selected ? Theme.accent : Theme.text-secondary; }
            if root.collection: Path { width: 18px; height: 18px; viewbox-width: 18; viewbox-height: 18; fill: transparent; stroke: Theme.accent; stroke-width: 1.2px; commands: "M2 2H7V7H2ZM11 2H16V7H11ZM2 11H7V16H2ZM11 11H16V16H11Z"; }
            if !root.home && !root.collection: Image {
                source: root.icon;
                width: 18px;
                height: 18px;
                image-rendering: smooth;
            }
        }

        Text {
            text: root.text;
            color: selected ? Theme.text-primary : Theme.text-secondary;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.count >= 0: Text { text: "" + root.count; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; }
    }

    side-ta := NavTouchArea {
        clicked => { if root.target != "" { AppState.request_navigate(root.target); } }
    }
}

// Fixed icon/text anchors keep drive names aligned with the Places links.
component DriveRow inherits Rectangle {
    in property <DriveItem> drive;
    property <bool> selected: AppState.current-path == drive.path;

    height: Metrics.sidebar-drive-height;
    border-width: selected ? 1px : 0px; border-color: Theme.accent;
    border-radius: Metrics.radius-md;
    background: selected ? Theme.sidebar-selected : (drive-ta.pressed ? Theme.surface-pressed : (drive-ta.has-hover ? Theme.sidebar-hover : transparent));

    Rectangle { x: 0; y: (parent.height - 14px) / 2; width: 3px; height: 14px; border-radius: 1.5px; background: Theme.accent; visible: root.selected; }
    Image { x: 12px; y: 13px; source: drive.icon; width: 20px; height: 20px; image-rendering: smooth; }
    Text {
        x: 40px; y: 9px; width: parent.width - 46px; height: 20px;
        text: drive.name; color: root.selected ? Theme.text-primary : Theme.text-secondary;
        font-size: 14px; vertical-alignment: center; overflow: elide;
    }
    Rectangle {
        x: 40px; y: 35px; width: parent.width - 54px; height: 6px;
        border-radius: 2px; background: Theme.surface-hover;
        visible: drive.capacity-known;
        Rectangle {
            x: 0; y: 0;
            height: parent.height;
            width: parent.width * Math.clamp(drive.usage, 0, 1);
            border-radius: 2px;
            background: drive.usage > 0.9 ? Theme.danger : Theme.accent;
            animate width { duration: AppState.animations ? 240ms : 0ms; easing: ease-out; }
        }
    }
    Text {
        x: 40px; y: 47px; width: parent.width - 48px; height: 18px;
        text: drive.capacity-known ? drive.free-text + " free of " + drive.total-text : drive.detail; color: Theme.text-muted;
        font-size: 11px; vertical-alignment: center; overflow: elide;
    }

    drive-ta := NavTouchArea {
        clicked => { if drive.path != "" { AppState.request_navigate(drive.path); } }
    }
}

component SectionLabel inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    height: 36px;
    Text { x: 12px; height: parent.height; text: root.text; color: Theme.text-secondary; font-size: 14px; font-weight: 400; vertical-alignment: center; }
    Text { x: parent.width - 64px; width: 52px; height: parent.height; text: root.detail; color: Theme.text-disabled; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
}

component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <int> column;
    in property <length> text-indent: 8px;
    in property <bool> right-align: false;

    height: 100%;
    background: header-ta.pressed ? Theme.surface-pressed : (header-ta.has-hover ? Theme.surface-hover : transparent);

    label := Text {
        x: root.right-align ? root.width - self.width - 24px : root.text-indent;
        width: self.preferred-width; height: root.height;
        text: root.text; color: Theme.text-secondary; font-size: 13px;
        vertical-alignment: center;
    }
    Path {
        x: label.x + label.width + 7px; y: (root.height - 5px) / 2;
        width: 8px; height: 5px; viewbox-width: 8; viewbox-height: 5;
        visible: AppState.sort_column == root.column;
        commands: AppState.sort_ascending ? "M1 4L4 1L7 4" : "M1 1L4 4L7 1";
        fill: transparent; stroke: Theme.accent; stroke-width: 1.2px;
    }

    header-ta := NavTouchArea {
        clicked => { AppState.request_sort(root.column); }
    }
}

component ResizeEdge inherits TouchArea {
    in property <int> direction;
    callback resize(int);
    mouse-cursor: direction == 0 || direction == 4 ? ns-resize : (direction == 2 || direction == 6 ? ew-resize : (direction == 1 || direction == 5 ? nesw-resize : nwse-resize));
    pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { root.resize(root.direction); } }
}
component ColumnGrip inherits Rectangle {
    callback moved-by(length);
    width: 10px;
    Rectangle { x: 4px; y: 6px; width: 1px; height: parent.height - 12px; background: grip.has-hover || grip.pressed ? Theme.accent : Theme.border; }
    grip := TouchArea {
        mouse-cursor: ew-resize;
        property <length> last-position;
        pointer-event(event) => { if event.button == PointerEventButton.left && event.kind == PointerEventKind.down { self.last-position = self.mouse-x + root.x; } }
        moved => { if self.pressed { let current-position = self.mouse-x + root.x; root.moved-by(current-position - self.last-position); self.last-position = current-position; } }
    }
}

component NameDialog inherits Rectangle {
    in-out property <string> title <=> AppState.dialog_title;
    visible: AppState.dialog_visible;
    background: #000000aa;
    TouchArea {}

    Rectangle {
        width: 420px;
        height: root.title == "Error" ? 236px : 184px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.surface-alt;
        border-radius: Metrics.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 20px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 6px;

        Text {
            x: 24px; y: 20px; width: 372px; height: 24px;
            text: root.title;
            color: root.title == "Error" ? Theme.danger : Theme.text-primary;
            font-size: 18px; font-weight: 600;
        }

        dialog-scope := FocusScope {
            x: 24px; y: 60px; width: 372px;
            height: root.title == "Error" ? 104px : 36px;
            key-pressed(event) => {
                if event.text == Key.Escape || (event.text == Key.Return && root.title == "Error") {
                    AppState.request_dialog_cancel();
                    accept
                } else { reject }
            }
            name-input := InputField {
                x: 0; y: 0; width: 372px; height: 36px;
                visible: root.title != "Error";
                font-size: 13px;
                text <=> AppState.dialog_value;
                accepted => { AppState.request_dialog_confirm(AppState.dialog_value); }
            }
            Text {
                x: 0; y: 0; width: 372px; height: 104px;
                visible: root.title == "Error";
                text: AppState.dialog_value;
                color: Theme.text-secondary;
                font-size: 12px;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        Rectangle {
            x: 220px; y: parent.height - 54px; width: 84px; height: 30px;
            visible: root.title != "Error";
            background: cancel-ta.pressed ? Theme.surface-pressed : Theme.surface-hover;
            border-radius: Metrics.radius-md;
            Text { text: "Cancel"; color: Theme.text-primary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
            cancel-ta := TouchArea { clicked => { AppState.request_dialog_cancel(); } }
        }
        Rectangle {
            x: 312px; y: parent.height - 54px; width: 84px; height: 30px;
            background: ok-ta.pressed ? Theme.text-secondary : Theme.accent;
            border-radius: Metrics.radius-md;
            Text { text: root.title == "Error" ? "Close" : (root.title == "Rename" ? "Rename" : "Create"); color: Theme.window-bg; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            ok-ta := TouchArea { clicked => { AppState.request_dialog_confirm(AppState.dialog_value); } }
        }
    }
    changed visible => {
        if self.visible {
            if root.title == "Error" { dialog-scope.focus(); }
            else { name-input.focus-field(); name-input.select-all-text(); }
        }
    }
}
export component MainWindow inherits Window {
    title: "Kova";
    icon: @image-url("../assets/kova.png");
    no-frame: true;
    resize-border-width: 0px;
    callback resize-window(int);
    callback window-action(int);
    in-out property <bool> window-maximized: false;
    property <length> inspector-width: 340px;
    property <float> preview-zoom: 1;
    property <bool> preview-fit: true;
    property <string> zoom-path: AppState.preview-path;
    changed zoom-path => { self.preview-fit = true; self.preview-zoom = 1; }
    property <length> tab-width: Math.min(240px, Math.max(140px, (root.width - 74px - 202px) / Math.max(1, AppState.tabs.length) - 4px));
    min-width: 760px;
    min-height: 500px;
    preferred-width: 1280px;
    preferred-height: 820px;
    default-font-family: "Segoe UI";
    background: Theme.window-bg;
    forward-focus: list-scope;

    // Window skeleton — absolute placement against the window, so every
    // region has a well-defined, non-negotiable geometry. Tabs and toolbar
    // share the window background and read as one chrome block; a single
    // hairline below the toolbar separates chrome from content.

    tabs := Rectangle {
        y: 0;
        x: 0;
        width: parent.width;
        height: Metrics.tabs-height;
        background: Theme.tabs-bg;

        tabs-nav := NavTouchArea {
            property <bool> dragging: false;
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    self.dragging = false;
                }
            }
            moved => {
                if self.pressed && !self.dragging && (Math.abs(self.mouse-x - self.pressed-x) > 4px || Math.abs(self.mouse-y - self.pressed-y) > 4px) {
                    self.dragging = true;
                    root.window-action(0);
                }
            }
            double-clicked => { root.window-action(2); }
        }

        Image {
            x: 20px; y: 12px; width: 25px; height: 24px;
            source: @image-url("../assets/kova-mark.svg");
            opacity: AppState.loading && AppState.animations && logo-pulse.dim ? 0.55 : 1;
            animate opacity { duration: 350ms; }
        }
        logo-pulse := Timer {
            property <bool> dim: false;
            running: AppState.loading && AppState.animations;
            interval: 650ms;
            triggered => { self.dim = !self.dim; }
        }
        app-menu := ContextMenuArea {
            x: 14px; y: 6px; width: 38px; height: 34px;
            Menu {
                MenuItem { title: "Use Kova for folders and drives"; enabled: !AppState.integration-busy; activated => { AppState.request-default-manager(true); } }
                MenuItem { title: "Restore previous folder app"; enabled: !AppState.integration-busy; activated => { AppState.request-default-manager(false); } }
            }
            TouchArea { clicked => { app-menu.show({x: 0px, y: 32px}); } }
        }

        tab-scroll := ScrollView {
            x: 68px;
            width: Math.min(AppState.tabs.length * (root.tab-width + 4px) + 12px, parent.width - 68px - 190px);
            height: parent.height;
            viewport-width: Math.max(self.width, AppState.tabs.length * (root.tab-width + 4px) + 12px);
            viewport-height: self.height;
            HorizontalLayout {
                width: tab-scroll.viewport-width;
                height: Metrics.tabs-height;
                padding: Metrics.space-xs;
                padding-left: 6px;
                spacing: 4px;
                alignment: start;
            for item[idx] in AppState.tabs: Rectangle {
                width: root.tab-width;
                height: 40px;
                border-radius: 8px;
                border-width: idx == AppState.active_tab ? 1px : 0px;
                border-color: Theme.border;
                background: idx == AppState.active_tab ? Theme.window-bg : (tab-ta.pressed ? Theme.surface-pressed : (tab-ta.has-hover ? Theme.surface-hover : transparent));

                tab-ta := NavTouchArea {
                    clicked => { AppState.request_switch_tab(idx); }
                }

                Rectangle {
                    x: 1px; y: parent.height - 5px; height: 5px; width: parent.width - 2px;
                    background: Theme.window-bg; visible: idx == AppState.active_tab;
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 3px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: center;
                        if item == "Home": IconHome { width: 15px; height: 15px; tint: idx == AppState.active_tab ? Theme.accent : Theme.text-muted; }
                        if item != "Home": IconFolderNew { width: 15px; height: 15px; tint: idx == AppState.active_tab ? Theme.accent : Theme.text-muted; }
                    }
                    Text {
                        text: item;
                        color: idx == AppState.active_tab ? Theme.text-primary : Theme.text-secondary;
                        font-size: 12px;
                        font-weight: idx == AppState.active_tab ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 4px;
                            background: close-ta.has-hover ? Theme.surface-hover : transparent;
                            visible: AppState.tabs.length > 1;

                            IconClose {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                tint: close-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                            }

                            close-ta := NavTouchArea {
                                clicked => { AppState.request_close_tab(idx); }
                            }
                        }
                    }
                }
            }

            }
        }
        Rectangle {
            x: tab-scroll.x + tab-scroll.width + 2px;
            y: 10px;
            width: 28px;
            height: 30px;
            border-radius: Metrics.radius-md;
            background: new-tab-ta.pressed ? Theme.surface-pressed : (new-tab-ta.has-hover ? Theme.surface-hover : transparent);
            IconPlus { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            new-tab-ta := NavTouchArea { clicked => { AppState.request_new_tab(); } }
        }
        HorizontalLayout {
            x: parent.width - 138px; y: 0; width: 138px; height: parent.height;
            spacing: 0px;
            Rectangle {
                width: 46px; background: min-ta.has-hover ? Theme.surface-hover : transparent;
                accessible-role: button; accessible-label: "Minimize";
                Rectangle { x: 18px; y: 20px; width: 10px; height: 1px; background: Theme.text-secondary; }
                min-ta := TouchArea { clicked => { root.window-action(1); } }
            }
            Rectangle {
                width: 46px; background: max-ta.has-hover ? Theme.surface-hover : transparent;
                accessible-role: button; accessible-label: root.window-maximized ? "Restore" : "Maximize";
                Rectangle { x: 19px; y: 13px; width: 9px; height: 9px; background: transparent; border-width: 1px; border-color: Theme.text-secondary; visible: root.window-maximized; }
                Rectangle { x: 17px; y: 15px; width: 10px; height: 10px; background: max-ta.has-hover ? Theme.surface-hover : Theme.tabs-bg; border-width: 1px; border-color: Theme.text-secondary; }
                max-ta := TouchArea { clicked => { root.window-action(2); } }
            }
            Rectangle {
                width: 46px; background: exit-ta.has-hover ? #c42b3b : transparent;
                accessible-role: button; accessible-label: "Close window";
                IconClose { x: 18px; y: 15px; tint: exit-ta.has-hover ? #ffffff : Theme.text-secondary; }
                exit-ta := TouchArea { clicked => { root.window-action(3); } }
            }
        }
    }
    toolbar := Rectangle {
        y: Metrics.tabs-height;
        x: 0;
        width: parent.width;
        height: Metrics.toolbar-height;
        background: Theme.window-bg;

        toolbar-nav := NavTouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
        }

        HorizontalLayout {
            width: parent.width; height: parent.height;
            padding-left: 14px; padding-right: 12px; padding-top: 6px; padding-bottom: 6px; spacing: 12px;
            NavIconButton { enabled: AppState.can_go_back; clicked => { AppState.request_back(); } FilesNavBack { tint: parent.enabled ? Theme.text-primary : Theme.text-disabled; x: 7px; y: 7px; } }
            NavIconButton { enabled: AppState.can_go_forward; clicked => { AppState.request_forward(); } FilesNavForward { tint: parent.enabled ? Theme.text-primary : Theme.text-disabled; x: 7px; y: 7px; } }
            NavIconButton { enabled: AppState.can_go_parent; clicked => { AppState.request_parent(); } FilesNavUp { tint: parent.enabled ? Theme.text-primary : Theme.text-disabled; x: 7px; y: 7px; } }
            NavIconButton { clicked => { AppState.request_refresh(); } FilesRefresh { x: 7px; y: 7px; } }
            address-field := InputField {
                height: 34px; horizontal-stretch: 1; quiet: false;
                background: Theme.window-bg;
                border-radius: 5px;
                left-inset: 12px;
                navigation: true;
                text <=> AppState.address_path;
                accepted => { AppState.request_navigate(AppState.address_path); list-scope.focus(); }
                cancelled => { AppState.address_path = AppState.current-path; list-scope.focus(); }
                HorizontalLayout {
                    x: 4px; y: 2px; width: parent.width - 12px; height: 30px;
                    visible: !address-field.editing;
                    alignment: start; spacing: 2px;
                    for crumb[index] in AppState.breadcrumbs: Rectangle {
                        width: Math.min(156px, crumb-label.preferred-width + 28px, (address-field.width - 54px) / Math.max(1, AppState.breadcrumbs.length));
                        height: 30px;
                        border-radius: Metrics.radius-sm;
                        background: crumb-ta.has-hover ? Theme.surface-hover : transparent;
                        crumb-label := Text { x: 8px; width: parent.width - 26px; height: parent.height; text: crumb.label; font-size: 13px; color: index == AppState.breadcrumbs.length - 1 ? Theme.text-primary : Theme.text-secondary; vertical-alignment: center; overflow: elide; }
                        Path { x: parent.width - 12px; y: 11px; width: 5px; height: 8px; viewbox-width: 5; viewbox-height: 8; fill: transparent; stroke: Theme.text-muted; stroke-width: 1px; commands: "M 1 1 L 4 4 L 1 7"; visible: index < AppState.breadcrumbs.length - 1; }
                        crumb-ta := NavTouchArea { clicked => { AppState.request_navigate(crumb.path); list-scope.focus(); } }
                    }
                }

            }
        }
    }

    // Content zone.
    content := Rectangle {
        y: Metrics.tabs-height + Metrics.toolbar-height + Metrics.actions-height;
        x: 0;
        width: parent.width;
        height: parent.height - Metrics.tabs-height - Metrics.toolbar-height - Metrics.actions-height - Metrics.statusbar-height;

        // Sidebar.
        sidebar := Rectangle {
            x: 0;
            y: 0;
            width: Metrics.sidebar-width;
            height: parent.height;
            background: Theme.sidebar-bg;
            Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.border; }

            sidebar-nav := NavTouchArea {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
            }

            sidebar-scroll := ScrollView {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: Math.max(self.height, 420px + AppState.drives.length * (Metrics.sidebar-drive-height + 2px) + (AppState.quick-access.length + AppState.library-groups.length) * 44px);
            VerticalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                height: sidebar-scroll.viewport-height;
                padding: Metrics.space-sm;
                spacing: 2px;
                alignment: start;

                SectionLabel { text: "Places  ⌄"; }
                SidebarButton { text: "Home"; home: true; target: "Home"; selected: AppState.drive-overview; }
                SidebarButton { text: "User folder"; icon: AppState.home_icon; target: AppState.home_path; selected: AppState.current-path == AppState.home_path; }
                SidebarButton { text: "Desktop"; icon: AppState.desktop_icon; target: AppState.desktop_path; selected: AppState.current-path == AppState.desktop_path; }
                SidebarButton { text: "Documents"; icon: AppState.documents_icon; target: AppState.documents_path; selected: AppState.current-path == AppState.documents_path; }
                SidebarButton { text: "Downloads"; icon: AppState.downloads_icon; target: AppState.downloads_path; selected: AppState.current-path == AppState.downloads_path; }

                Rectangle { height: Metrics.space-md; }
                if AppState.quick-access.length > 0: SectionLabel { text: "Quick access"; }
                for pin[index] in AppState.quick-access: ContextMenuArea {
                    height: Metrics.sidebar-item-height;
                    Menu {
                        MenuItem { title: "Remove from Quick access"; activated => { AppState.library-action(1, "" + index, ""); } }
                        MenuItem { title: "Move up"; enabled: index > 0; activated => { AppState.library-action(2, "" + index, ""); } }
                        MenuItem { title: "Move down"; enabled: index + 1 < AppState.quick-access.length; activated => { AppState.library-action(3, "" + index, ""); } }
                    }
                    SidebarButton { text: pin.name; icon: AppState.home_icon; target: pin.key; selected: AppState.current-path == pin.key; }
                }
                if AppState.library-groups.length > 0: SectionLabel { text: "Collections & tags"; }
                for group in AppState.library-groups: ContextMenuArea {
                    height: Metrics.sidebar-item-height;
                    Menu {
                        MenuItem { title: "Add selection"; enabled: AppState.selected_count > 0; activated => { AppState.library-action(group.tag ? 5 : 4, "", group.name); } }
                        MenuItem { title: "Remove group (keep files)"; activated => { AppState.library-action(7, group.key, ""); } }
                    }
                    SidebarButton { text: (group.tag ? "# " : "") + group.name; count: group.count; collection: true; target: group.key; selected: AppState.current-path == group.key; }
                }
                SectionLabel { text: "Drives  ⌄"; }
                for drive in AppState.drives: DriveRow { drive: drive; }
            }

            }

        }

        actionbar := Rectangle {
            x: 0; y: -Metrics.actions-height;
            width: parent.width;
            height: Metrics.actions-height;
            background: Theme.sidebar-bg;
            Rectangle { y: 0; height: 1px; width: parent.width; background: Theme.border; }
            Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.border; }
            HorizontalLayout {
                padding: 7px; spacing: root.width < 1000px ? 4px : 8px;

                ActionButton { label: "New folder"; shortcut: "Ctrl+Shift+N"; show-label: root.width >= 1000px; width: root.width >= 1000px ? 120px : 36px; enabled: !AppState.creating-folder && AppState.filesystem-location && !AppState.loading && AppState.directory-error == ""; triggered => { list-scope.focus(); AppState.request_new_folder(); } IconFolderNew { x: 10px; y: 9px; tint: parent.enabled ? Theme.accent : Theme.text-disabled; } }
                Rectangle { width: 1px; background: Theme.border-subtle; }
                ActionButton { label: "Cut"; shortcut: "Ctrl+X"; show-label: root.width >= 1240px; enabled: AppState.selected_count > 0; triggered => { list-scope.focus(); AppState.request_cut(); } FilesCut { x: 9px; y: 8px; tint: parent.enabled ? Theme.text-secondary : Theme.text-disabled; accent: parent.enabled ? Theme.accent : Theme.text-disabled; } }
                ActionButton { label: "Copy"; shortcut: "Ctrl+C"; show-label: root.width >= 1240px; enabled: AppState.selected_count > 0; triggered => { list-scope.focus(); AppState.request_copy(); } FilesCopy { x: 9px; y: 8px; tint: parent.enabled ? Theme.text-secondary : Theme.text-disabled; accent: parent.enabled ? Theme.accent : Theme.text-disabled; } }
                ActionButton { label: "Paste"; shortcut: "Ctrl+V"; show-label: root.width >= 1240px; enabled: AppState.filesystem-location && !AppState.loading && AppState.directory-error == ""; triggered => { list-scope.focus(); AppState.request_paste(); } FilesPaste { x: 9px; y: 8px; tint: parent.enabled ? Theme.text-secondary : Theme.text-disabled; accent: parent.enabled ? Theme.accent : Theme.text-disabled; } }
                ActionButton { label: "Rename"; shortcut: "F2"; show-label: root.width >= 1240px; enabled: AppState.selected_count == 1; triggered => { list-scope.focus(); AppState.request_rename(-1); } FilesRename { x: 9px; y: 8px; tint: parent.enabled ? Theme.text-secondary : Theme.text-disabled; accent: parent.enabled ? Theme.accent : Theme.text-disabled; } }
                ActionButton { label: "Delete"; shortcut: "Del"; show-label: root.width >= 1240px; enabled: AppState.selected_count > 0; triggered => { list-scope.focus(); AppState.request_delete(); } FilesDelete { x: 9px; y: 8px; tint: parent.enabled ? Theme.text-secondary : Theme.text-disabled; accent: parent.enabled ? Theme.accent : Theme.text-disabled; } }
                TextButton { text: "Open"; width: 48px; enabled: AppState.selected_count == 1; clicked => { list-scope.focus(); AppState.request_activate(-1); } }
                TextButton { text: "More"; width: 48px; enabled: AppState.selected_count > 0; clicked => { list-scope.focus(); AppState.request_shell_menu(AppState.primary-row); } }
                TextButton { text: "Organize"; width: 76px; clicked => { AppState.library-visible = true; } }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 70px; border-radius: 4px; background: Theme.surface;
                    for label[index] in ["☰", "▦"]: Rectangle {
                        x: index * 35px; width: 35px; height: parent.height;
                        border-radius: 4px;
                        background: (AppState.gallery ? index == 1 : index == 0) ? Theme.selection : (mode-touch.has-hover ? Theme.surface-hover : transparent);
                        Text { text: label; color: Theme.text-primary; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                        mode-touch := NavTouchArea { clicked => { AppState.gallery = index == 1; list-scope.focus(); } }
                    }
                }
                view-menu := ContextMenuArea {
                    width: root.width >= 1000px ? 104px : 76px;
                    Menu {
                        MenuItem { title: "Details"; checkable: true; checked: !AppState.gallery; activated => { AppState.gallery = false; } }
                        MenuItem { title: "Gallery"; checkable: true; checked: AppState.gallery; activated => { AppState.gallery = true; } }
                        Menu {
                            title: "Thumbnail size";
                            MenuItem { title: "Small"; checkable: true; checked: AppState.gallery-size == 0; activated => { AppState.gallery-size = 0; AppState.gallery = true; } }
                            MenuItem { title: "Medium"; checkable: true; checked: AppState.gallery-size == 1; activated => { AppState.gallery-size = 1; AppState.gallery = true; } }
                            MenuItem { title: "Large"; checkable: true; checked: AppState.gallery-size == 2; activated => { AppState.gallery-size = 2; AppState.gallery = true; } }
                        }
                        MenuSeparator { }
                        MenuItem { title: "Preview"; checkable: true; checked: AppState.preview-visible; activated => { AppState.request-view-option(3); } }
                        MenuItem { title: "Pin folder to Quick access"; enabled: AppState.library-writable && AppState.filesystem-location; activated => { AppState.library-action(0, "", ""); } }
                        MenuItem { title: "Analyze storage"; enabled: AppState.filesystem-location; activated => { AppState.request-analyze(""); } }
                        MenuItem { title: "Drives and storage"; activated => { AppState.request_navigate("Home"); } }
                        MenuSeparator { }
                        MenuItem { title: "Show hidden files"; checkable: true; checked: AppState.show-hidden; activated => { AppState.request-view-option(0); } }
                        MenuItem { title: "Show system files"; checkable: true; checked: AppState.show-system; activated => { AppState.request-view-option(1); } }
                        MenuItem { title: "Show file extensions"; checkable: true; checked: AppState.show-extensions; activated => { AppState.request-view-option(2); } }
                        MenuItem { title: "Calculate folder sizes"; checkable: true; checked: AppState.folder-sizes; activated => { AppState.request-view-option(7); } }
                        MenuSeparator { }
                        MenuItem { title: "Compact rows"; checkable: true; checked: AppState.compact-rows; activated => { AppState.request-view-option(4); } }
                        MenuItem { title: "Alternating row colors"; checkable: true; checked: AppState.alternating-rows; activated => { AppState.request-view-option(5); } }
                        MenuItem { title: "Animations"; checkable: true; checked: AppState.animations; activated => { AppState.request-view-option(6); } }
                    }
                    Rectangle {
                        border-radius: Metrics.radius-sm;
                        background: view-touch.has-hover ? Theme.surface-hover : transparent;
                        Text { text: "☷  View  ⌄"; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; font-size: 14px; }
                        view-touch := TouchArea { clicked => { view-menu.show({ x: self.width - 220px, y: self.height }); } }
                    }
                }
            }
        }

        preview-panel := Rectangle {
            visible: AppState.preview-visible && !AppState.drive-overview;
            width: Math.clamp(root.inspector-width, 260px, Math.max(260px, root.width - Metrics.sidebar-width - 280px));
            x: parent.width - self.width - Metrics.space-sm;
            y: 64px;
            height: parent.height - self.y;
            border-radius: Metrics.radius-lg;
            border-width: 1px; border-color: Theme.border-subtle;
            background: Theme.content-bg;
            Text {
                x: 14px; y: 0; width: parent.width - 56px; height: 42px;
                text: AppState.preview-title; overflow: elide;
                color: Theme.text-primary; font-size: 13px; font-weight: 600; vertical-alignment: center;
            }
            Rectangle {
                x: parent.width - 34px; y: 8px; width: 26px; height: 26px; border-radius: Metrics.radius-sm;
                background: preview-close.has-hover ? Theme.surface-hover : transparent;
                Path { x: 8px; y: 8px; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10; commands: "M1 1L9 9M9 1L1 9"; fill: transparent; stroke: Theme.text-secondary; stroke-width: 1.2px; }
                preview-close := TouchArea { clicked => { AppState.request-view-option(3); } }
            }
            Rectangle { x: 12px; y: 42px; width: parent.width - 24px; height: 1px; background: Theme.border; }
            Text {
                x: 14px; y: 44px; width: parent.width - 28px; height: 20px;
                text: AppState.preview-info; color: Theme.text-muted; font-size: 11px;
                overflow: elide; vertical-alignment: center;
            }
            if AppState.preview-has-image: HorizontalLayout {
                x: 12px; y: 68px; width: parent.width - 24px; height: 28px; spacing: 4px;
                Text { text: "Zoom"; color: Theme.text-muted; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
                NavIconButton { width: 28px; height: 28px; enabled: root.preview-fit || root.preview-zoom > 0.25;
                    accessible-role: button; accessible-label: "Zoom out";
                    clicked => { root.preview-fit = false; root.preview-zoom = Math.max(0.25, root.preview-zoom - 0.25); }
                    Text { text: "−"; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                }
                NavIconButton { width: 60px; height: 28px;
                    accessible-role: button; accessible-label: "Fit or actual preview pixels";
                    clicked => { root.preview-fit = !root.preview-fit; root.preview-zoom = 1; }
                    Text { text: root.preview-fit ? "Fit" : Math.round(root.preview-zoom * 100) + "%"; color: Theme.accent; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                }
                NavIconButton { width: 28px; height: 28px; enabled: root.preview-fit || root.preview-zoom < 4;
                    accessible-role: button; accessible-label: "Zoom in";
                    clicked => { root.preview-fit = false; root.preview-zoom = Math.min(4, root.preview-zoom + 0.25); }
                    IconPlus { x: 7px; y: 7px; }
                }
            }
            if AppState.preview-has-image: Rectangle {
                x: 12px; y: 104px; width: parent.width - 24px; height: Math.max(100px, parent.height * 0.48 - 110px);
                background: Theme.sidebar-bg; border-radius: Metrics.radius-md; clip: true;
                ScrollView {
                    width: parent.width; height: parent.height;
                    viewport-width: root.preview-fit ? self.width : Math.max(self.width, AppState.preview-pixel-width * root.preview-zoom * 1px);
                    viewport-height: root.preview-fit ? self.height : Math.max(self.height, AppState.preview-pixel-height * root.preview-zoom * 1px);
                    Image {
                        width: root.preview-fit ? parent.width : AppState.preview-pixel-width * root.preview-zoom * 1px;
                        height: root.preview-fit ? parent.height : AppState.preview-pixel-height * root.preview-zoom * 1px;
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        source: AppState.preview-image; image-fit: contain;
                    }
                }
            }
            if !AppState.preview-has-image: ScrollView {
                x: 12px; y: 72px; width: parent.width - 24px; height: Math.max(100px, parent.height * 0.48 - 82px);
                viewport-width: self.width;
                viewport-height: Math.max(self.height, preview-copy.preferred-height + 8px);
                preview-copy := Text {
                    width: parent.width - 14px; text: AppState.preview-text;
                    wrap: word-wrap; font-family: "Consolas"; font-size: 12px; color: Theme.text-secondary;
                }
            }
            if AppState.preview-has-image: HorizontalLayout {
                x: 12px; y: parent.height * 0.48 - 2px; width: parent.width - 24px; height: 30px; spacing: 6px;
                if AppState.preview-animated: ActionButton {
                    width: 88px; height: 30px;
                    label: AppState.preview-paused ? "Play" : "Pause";
                    triggered => { AppState.preview-paused = !AppState.preview-paused; }
                    Path {
                        x: 10px; y: 8px; width: 14px; height: 14px;
                        viewbox-width: 14; viewbox-height: 14;
                        commands: AppState.preview-paused ? "M3 1L12 7L3 13Z" : "M3 2H5V12H3ZM9 2H11V12H9Z";
                        fill: Theme.accent;
                    }
                }
                if AppState.preview-pages > 0: NavIconButton { enabled: AppState.preview-page > 0; width: 30px; clicked => { AppState.preview-page -= 1; } FilesNavBack { x: 7px; y: 7px; width: 16px; height: 16px; tint: parent.enabled ? Theme.text-secondary : Theme.text-disabled; } }
                Text { text: AppState.preview-text; color: Theme.text-muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; }
                if AppState.preview-pages > 0: NavIconButton { enabled: AppState.preview-page + 1 < AppState.preview-pages; width: 30px; clicked => { AppState.preview-page += 1; } FilesNavForward { x: 7px; y: 7px; width: 16px; height: 16px; tint: parent.enabled ? Theme.text-secondary : Theme.text-disabled; } }
            }
            Rectangle { x: 14px; y: parent.height * 0.48 + 36px; width: parent.width - 28px; height: 1px; background: Theme.border-subtle; }
            ScrollView {
                x: 14px; y: parent.height * 0.48 + 46px; width: parent.width - 28px; height: parent.height - self.y - 12px;
                viewport-width: self.width;
                viewport-height: info-layout.preferred-height;
                info-layout := VerticalLayout {
                    width: parent.width - 12px; spacing: 12px;
                    Text { text: "FILE INFORMATION"; color: Theme.text-muted; font-size: 10px; font-weight: 600; height: 20px; }
                    for item in AppState.inspector-info: HorizontalLayout {
                        spacing: 8px;
                        Text { width: 68px; text: item.label; color: Theme.text-muted; font-size: 11px; }
                        Text { horizontal-stretch: 1; text: item.value; color: Theme.text-primary; font-size: 12px; wrap: word-wrap; }
                    }
                }
            }

        }

        Rectangle {
            visible: preview-panel.visible;
            x: preview-panel.x - 4px; y: preview-panel.y;
            width: 8px; height: preview-panel.height;
            Rectangle { x: 2px; width: 2px; height: parent.height; border-radius: 1px; background: splitter.has-hover || splitter.pressed ? Theme.accent.with-alpha(0.5) : transparent; }
            splitter := TouchArea {
                mouse-cursor: ew-resize;
                property <length> start-width;
                property <length> start-position;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        self.start-width = preview-panel.width;
                        self.start-position = self.mouse-x + parent.x;
                    }
                }
                moved => { if self.pressed { root.inspector-width = Math.clamp(self.start-width + self.start-position - (self.mouse-x + parent.x), 260px, Math.max(260px, root.width - Metrics.sidebar-width - 280px)); } }
                double-clicked => { root.inspector-width = 340px; }
            }
        }

        Rectangle {
            visible: !AppState.drive-overview;
            x: Metrics.sidebar-width; y: 0; width: parent.width - self.x; height: 64px;
            background: Theme.sidebar-bg;
            Text { x: 20px; y: 10px; height: 26px; width: parent.width - search-field.width - 60px; text: AppState.tabs[AppState.active_tab]; font-size: 18px; font-weight: 600; color: Theme.text-primary; overflow: elide; }
            Text { x: 20px; y: 36px; height: 20px; text: AppState.item_count + (AppState.item_count == 1 ? " item" : " items") + (AppState.selected_count > 0 ? " · " + AppState.selected_count + " selected" : ""); font-size: 13px; color: Theme.text-muted; }
            search-field := InputField {
                x: parent.width - self.width - 16px; y: 14px;
                width: Math.clamp(parent.width * 0.4, 240px, 420px); height: 36px;
                placeholder: "Search folder · type:image size:>100MB";
                text <=> AppState.search-text;
                edited(value) => { AppState.request-search(value); }
                accepted => { list-scope.focus(); }
                cancelled => { AppState.request-search(""); list-scope.focus(); }
            }
            Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.border; }
        }
        // File list column.
        file-list := Rectangle {
            visible: !AppState.drive-overview;
            property <length> type-width: 140px;
            property <length> size-width: 148px;
            property <length> date-width: 200px;
            property <bool> show-type: self.width >= 760px;
            property <bool> show-size: self.width >= 430px;
            property <bool> show-date: self.width >= 640px;
            property <length> actual-type: self.show-type ? Math.min(self.type-width, (self.width - 224px) * 0.24) : 0px;
            property <length> actual-size: self.show-size ? Math.min(self.size-width, (self.width - 224px) * 0.29) : 0px;
            property <length> actual-date: self.show-date ? Math.min(self.date-width, (self.width - 224px) * 0.39) : 0px;
            property <length> name-width: self.width - 16px - self.actual-type - self.actual-size - self.actual-date;
            property <int> columns: AppState.gallery ? Math.max(1, Math.floor((self.width - 14px) / (AppState.gallery-size == 0 ? 132px : AppState.gallery-size == 1 ? 188px : 252px))) : 1;
            property <length> tile-width: (self.width - 14px) / self.columns;
            property <length> item-height: AppState.gallery ? (AppState.gallery-size == 0 ? 156px : AppState.gallery-size == 1 ? 212px : 276px) : Metrics.row-height;
            property <bool> focus-pending: false;
            changed visible => { self.focus-pending = self.visible; }
            // Defer focus until Slint has finished changing the visible tree.
            Timer { running: parent.focus-pending; interval: 1ms; triggered => { parent.focus-pending = false; list-scope.focus(); } }
            x: Metrics.sidebar-width;
            y: 64px;
            width: parent.width - Metrics.sidebar-width - Metrics.space-sm - (AppState.preview-visible ? preview-panel.width + Metrics.panel-gap : 0px);
            height: parent.height - 64px;
            background: Theme.content-bg;
            border-radius: 0px;
            clip: true;

            // Catches mouse back/forward and empty-area clicks for the whole
            // file column; interactive children grab their events first.
            list-nav := NavTouchArea {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                clicked => {
                    if !AppState.dialog_visible {
                        AppState.request_clear_selection();
                    }
                }
            }

            Rectangle {
                visible: !AppState.gallery;
                x: 0;
                y: 0;
                width: parent.width;
                height: Metrics.header-height;
                background: Theme.content-bg;

                HeaderCell { x: 0; text: "Name"; column: 0; width: file-list.name-width; text-indent: 28px; }
                HeaderCell { visible: file-list.show-type; x: file-list.name-width; width: file-list.actual-type; text: "Type"; column: 1; text-indent: 14px; }
                HeaderCell { visible: file-list.show-size; x: file-list.name-width + file-list.actual-type; width: file-list.actual-size; text: "Size"; column: 2; right-align: true; }
                HeaderCell { visible: file-list.show-date; x: file-list.name-width + file-list.actual-type + file-list.actual-size; width: file-list.actual-date; text: "Modified"; column: 3; text-indent: 14px; }
                ColumnGrip {
                    x: file-list.name-width - 5px; height: parent.height; visible: file-list.show-size;
                    moved-by(delta) => { if file-list.show-type { file-list.type-width = Math.clamp(file-list.actual-type - delta, 80px, 280px); } else { file-list.size-width = Math.clamp(file-list.actual-size - delta, 80px, 280px); } }
                }
                ColumnGrip {
                    x: file-list.name-width + file-list.actual-type - 5px; height: parent.height; visible: file-list.show-type;
                    moved-by(delta) => { file-list.type-width = Math.clamp(file-list.actual-type + delta, 80px, 280px); file-list.size-width = Math.clamp(file-list.actual-size - delta, 80px, 280px); }
                }
                ColumnGrip {
                    x: file-list.name-width + file-list.actual-type + file-list.actual-size - 5px; height: parent.height; visible: file-list.show-date;
                    moved-by(delta) => { file-list.date-width = Math.clamp(file-list.actual-date - delta, 120px, 320px); }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: parent.width;
                    background: Theme.border-subtle;
                }
            }

            // Context menu for the empty list area. Right clicks over rows
            // never reach this menu because the row TouchAreas grab the
            // press first; those rows open the native shell menu instead.
            if AppState.gallery: Rectangle {
                x: 0; y: 0; height: Metrics.header-height; width: parent.width;
                Text { x: 20px; height: parent.height; text: "Gallery"; color: Theme.text-muted; font-size: 12px; vertical-alignment: center; }
                ContextMenuArea {
                    x: parent.width - 132px; width: 120px; height: parent.height;
                    Menu {
                        MenuItem { title: "Name"; activated => { AppState.request_sort(0); } }
                        MenuItem { title: "Type"; activated => { AppState.request_sort(1); } }
                        MenuItem { title: "Size"; activated => { AppState.request_sort(2); } }
                        MenuItem { title: "Modified"; activated => { AppState.request_sort(3); } }
                    }
                    Text { text: "Sort: " + (AppState.sort_column == 0 ? "Name" : AppState.sort_column == 1 ? "Type" : AppState.sort_column == 2 ? "Size" : "Modified") + (AppState.sort_ascending ? " +" : " -"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
                    TouchArea { clicked => { parent.show({ x: 0px, y: self.height }); } }
                }
            }
            empty-area-menu := ContextMenuArea {
                x: 0;
                y: Metrics.header-height;
                width: parent.width;
                height: parent.height - Metrics.header-height;

                Menu {
                    MenuItem {
                        title: "New folder";
                        enabled: AppState.filesystem-location && !AppState.loading && AppState.directory-error == "";
                        activated => { AppState.request_new_folder(); }
                    }
                    MenuItem {
                        title: "Paste";
                        enabled: AppState.filesystem-location && !AppState.loading && AppState.directory-error == "";
                        activated => { AppState.request_paste(); }
                    }
                    MenuSeparator { }
                    MenuItem {
                        title: "Open folder in new tab";
                        activated => { AppState.request_duplicate_location(); }
                    }
                    Menu {
                        title: "Sort by";
                        enabled: !AppState.loading && AppState.item_count > 0;
                        MenuItem { title: "Name"; checkable: true; checked: AppState.sort_column == 0; activated => { if (AppState.sort_column != 0) { AppState.request_sort(0); } } }
                        MenuItem { title: "Type"; checkable: true; checked: AppState.sort_column == 1; activated => { if (AppState.sort_column != 1) { AppState.request_sort(1); } } }
                        MenuItem { title: "Size"; checkable: true; checked: AppState.sort_column == 2; activated => { if (AppState.sort_column != 2) { AppState.request_sort(2); } } }
                        MenuItem { title: "Date modified"; checkable: true; checked: AppState.sort_column == 3; activated => { if (AppState.sort_column != 3) { AppState.request_sort(3); } } }
                        MenuSeparator { }
                        MenuItem { title: "Ascending"; checkable: true; checked: AppState.sort_ascending; activated => { if (!AppState.sort_ascending) { AppState.request_sort(AppState.sort_column); } } }
                        MenuItem { title: "Descending"; checkable: true; checked: !AppState.sort_ascending; activated => { if (AppState.sort_ascending) { AppState.request_sort(AppState.sort_column); } } }
                    }
                    MenuItem {
                        title: "Refresh";
                        activated => { AppState.request_refresh(); }
                    }
                    MenuSeparator { }
                    MenuItem {
                        title: "Select all";
                        enabled: !AppState.loading && AppState.item_count > 0;
                        activated => { AppState.request_select_all(); }
                    }
                    MenuItem {
                        title: "Clear selection";
                        enabled: AppState.selected_count > 0;
                        activated => { AppState.request_clear_selection(); }
                    }
                }

                list-scope := FocusScope {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;

                    property <int> reveal-index: -1;
                    property <int> reveal-ticks: 0;
                    function reveal(index: int) {
                        self.reveal-index = index;
                        self.reveal-ticks = 3;
                        self.position-selection();
                    }
                    function position-selection() {
                        let index = self.reveal-index;
                        let top = Math.floor(index / file-list.columns) * file-list.item-height;
                        if top + file-viewport.viewport-y < 0px { file-viewport.viewport-y = -top; }
                        else if top + file-list.item-height + file-viewport.viewport-y > file-viewport.visible-height { file-viewport.viewport-y = file-viewport.visible-height - top - file-list.item-height; }
                    }
                    Timer { running: list-scope.reveal-ticks > 0; interval: 16ms; triggered => { list-scope.reveal-ticks -= 1; list-scope.position-selection(); } }
                    key-pressed(event) => {
                        if event.text == "f" && event.modifiers.control {
                            search-field.focus-field(); search-field.select-all-text(); accept
                        } else if !event.modifiers.alt && (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow || event.text == Key.Home || event.text == Key.End) && AppState.files.length > 0 {
                            let delta = event.text == Key.UpArrow ? -file-list.columns : event.text == Key.DownArrow ? file-list.columns : event.text == Key.LeftArrow ? -1 : 1;
                            let index = event.text == Key.Home ? 0 : event.text == Key.End ? AppState.files.length - 1 : Math.clamp(AppState.primary-row < 0 ? 0 : AppState.primary-row + delta, 0, AppState.files.length - 1);
                            if event.modifiers.shift { AppState.request_range(index); } else { AppState.request_select(index); }
                            self.reveal(index); accept
                        } else if (event.text == "n" || event.text == "N") && event.modifiers.control && event.modifiers.shift {
                            AppState.request_new_folder(); accept
                        } else if event.text == "h" && event.modifiers.control {
                            AppState.request-view-option(0); accept
                        } else if event.text == " " && !event.modifiers.control && !event.modifiers.alt {
                            AppState.request-view-option(3); accept
                        } else if event.text == "a" && event.modifiers.control {
                            AppState.request_select_all();
                            accept
                        } else if event.text == Key.F5 {
                            AppState.request_refresh();
                            accept
                        } else if event.text == Key.F2 {
                            AppState.request_rename(-1);
                            accept
                        } else if event.text == Key.Return {
                            AppState.request_activate(-1);
                            accept
                        } else if event.text == Key.Delete {
                            AppState.request_delete();
                            accept
                        } else if event.text == "c" && event.modifiers.control {
                            AppState.request_copy();
                            accept
                        } else if event.text == "x" && event.modifiers.control {
                            AppState.request_cut();
                            accept
                        } else if event.text == "v" && event.modifiers.control {
                            AppState.request_paste();
                            accept
                        } else if event.text == "t" && event.modifiers.control {
                            AppState.request_context_open_in_new_tab(-1);
                            accept
                        } else if event.text == Key.Escape {
                            if marquee.armed { marquee.finish(true); } else { AppState.request_clear_selection(); }
                            accept
                        } else if event.text == Key.LeftArrow && event.modifiers.alt {
                            AppState.request_back();
                            accept
                        } else if event.text == Key.RightArrow && event.modifiers.alt {
                            AppState.request_forward();
                            accept
                        } else if event.text == Key.UpArrow && event.modifiers.alt {
                            AppState.request_parent();
                            accept
                        } else if event.text == "l" && event.modifiers.control {
                            // Standard "focus address bar" shortcut (browser /
                            // Explorer behavior): focus + select all, so typing
                            // replaces the current path.
                            address-field.focus-field();
                            address-field.select-all-text();
                            accept
                        } else {
                            reject
                        }
                    }

                    file-viewport := ListView {
                        property <length> layout-height: file-list.item-height;
                        property <int> layout-columns: file-list.columns;
                        property <int> previous-columns: 1;
                        property <length> previous-height: Metrics.row-height;
                        function update-visible() {
                            AppState.first-visible-row = Math.max(0, Math.floor(-self.viewport-y / file-list.item-height)) * file-list.columns;
                            AppState.visible-row-count = (Math.ceil(self.height / file-list.item-height) + 2) * file-list.columns;
                        }
                        function restore-position() {
                            let first = Math.max(0, Math.floor(-self.viewport-y / self.previous-height)) * self.previous-columns;
                            self.viewport-y = -Math.floor(first / file-list.columns) * file-list.item-height;
                            self.previous-columns = file-list.columns;
                            self.previous-height = file-list.item-height;
                            self.update-visible();
                        }
                        changed layout-height => { self.restore-position(); }
                        changed layout-columns => { self.restore-position(); }
                        changed viewport-y => { self.update-visible(); }
                        changed height => { self.update-visible(); }
                        width: parent.width;
                        height: parent.height;

                        for row in Math.ceil(AppState.files.length / file-list.columns): Rectangle {
                            height: file-list.item-height;
                            for column in file-list.columns: Rectangle {
                                property <int> idx: row * file-list.columns + column;
                                property <FileListItem> item: AppState.files[self.idx];
                                visible: self.idx < AppState.files.length;
                                x: column * file-list.tile-width;
                                width: file-list.tile-width; height: file-list.item-height;
                                row-pill := Rectangle {
                                    x: AppState.gallery ? 6px : 8px; y: AppState.gallery ? 6px : 1px;
                                    width: parent.width - (AppState.gallery ? 12px : 2px); height: parent.height - (AppState.gallery ? 12px : 2px);
                                    border-radius: AppState.gallery ? 7px : 4px;
                                    border-width: parent.item.selected ? 1px : 0px;
                                    border-color: list-scope.has-focus && AppState.primary-row == parent.idx ? Theme.accent.with-alpha(0.75) : transparent;
                                    background: parent.item.selected ? Theme.selection : (marquee.has-hover && marquee.hover-row == parent.idx ? Theme.surface-hover : (AppState.alternating-rows && Math.mod(parent.idx, 2) == 1 && !AppState.gallery ? Theme.surface-alt.with-alpha(0.22) : transparent));
                                    animate background { duration: AppState.animations ? 90ms : 0ms; }
                                }
                                Image {
                                    x: AppState.gallery ? (parent.width - self.width) / 2 : 28px;
                                    y: AppState.gallery ? 18px : (parent.height - 20px) / 2;
                                    width: AppState.gallery ? (parent.item.has-thumbnail ? parent.width - 32px : 56px) : 20px;
                                    height: AppState.gallery ? parent.height - 80px : 20px;
                                    source: parent.item.has-thumbnail ? parent.item.thumbnail : AppState.icons[parent.item.icon-id]; image-fit: contain;
                                }
                                Text {
                                    x: AppState.gallery ? 14px : 60px; y: AppState.gallery ? parent.height - 54px : 0px;
                                    width: AppState.gallery ? parent.width - 28px : file-list.name-width - 72px;
                                    height: AppState.gallery ? 24px : parent.height;
                                    text: parent.item.name; font-size: 14px; color: Theme.text-primary;
                                    vertical-alignment: center; horizontal-alignment: AppState.gallery ? center : left; overflow: elide;
                                }
                                Text { visible: AppState.gallery; x: 14px; y: parent.height - 30px; width: parent.width - 28px; height: 16px; text: parent.item.is-dir ? "Folder" : parent.item.size_text; color: Theme.text-muted; font-size: 11px; horizontal-alignment: center; overflow: elide; }
                                Text { visible: !AppState.gallery && file-list.show-type; x: file-list.name-width + 14px; width: file-list.actual-type - 24px; height: parent.height; text: parent.item.type_name; font-size: 13px; color: Theme.text-muted; vertical-alignment: center; overflow: elide; }
                                Text { visible: !AppState.gallery && file-list.show-size; x: file-list.name-width + file-list.actual-type + 4px; width: file-list.actual-size - 18px; height: parent.height; text: parent.item.size_text; font-size: 13px; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
                                Text { visible: !AppState.gallery && file-list.show-date; x: file-list.name-width + file-list.actual-type + file-list.actual-size + 14px; width: file-list.actual-date - 20px; height: parent.height; text: parent.item.modified_text; font-size: 13px; color: Theme.text-muted; vertical-alignment: center; overflow: elide; }
                            }
                        }
                    }

                    // One stable input surface keeps the pointer capture alive
                    // while rows are virtualized or the list scrolls underneath.
                    marquee := TouchArea {
                        width: parent.width - 14px; height: parent.height;
                        enabled: !AppState.dialog_visible;
                        property <bool> armed: false;
                        property <bool> dragging: false;
                        property <bool> additive: false;
                        property <length> start-x;
                        property <length> start-y;
                        property <int> hover-row: Math.floor((self.mouse-y - file-viewport.viewport-y) / file-list.item-height) * file-list.columns + (AppState.gallery ? Math.clamp(Math.floor(self.mouse-x / file-list.tile-width), 0, file-list.columns - 1) : 0);
                        property <string> context: AppState.current-path + "/" + AppState.active_tab + "/" + AppState.sort_column + "/" + (AppState.sort_ascending ? "asc" : "desc") + "/" + (AppState.loading ? "loading" : "ready") + (AppState.show-hidden ? "hidden" : "") + (AppState.show-system ? "system" : "") + file-list.item-height / 1px + file-list.columns + AppState.search-text;
                        changed context => { self.finish(false); }
                        function update-band() {
                            if self.armed && self.dragging {
                                let end-y = Math.clamp(self.mouse-y, 0px, self.height) - file-viewport.viewport-y;
                                AppState.request-grid-marquee(1, Math.floor(Math.min(self.start-y, end-y) / file-list.item-height), Math.ceil(Math.max(self.start-y, end-y) / file-list.item-height), AppState.gallery ? Math.floor(Math.min(self.start-x, self.mouse-x) / file-list.tile-width) : 0, AppState.gallery ? Math.ceil(Math.max(self.start-x, self.mouse-x) / file-list.tile-width) : 1, file-list.columns, self.additive);
                            }
                        }
                        function finish(cancel: bool) {
                            if self.armed { AppState.request-grid-marquee(cancel ? 3 : 2, 0, 0, 0, 0, file-list.columns, false); }
                            self.armed = false; self.dragging = false;
                        }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                list-scope.focus();
                                if event.button == PointerEventButton.back { AppState.request_back(); }
                                else if event.button == PointerEventButton.forward { AppState.request_forward(); }
                                else if event.button == PointerEventButton.right {
                                    if self.hover-row >= 0 && self.hover-row < AppState.files.length {
                                        if !AppState.files[self.hover-row].selected { AppState.request_select(self.hover-row); }
                                        AppState.request_shell_menu(self.hover-row);
                                    } else { empty-area-menu.show({ x: self.mouse-x, y: self.mouse-y }); }
                                } else if event.button == PointerEventButton.left && !AppState.loading {
                                    if AppState.inline-visible { AppState.request_dialog_confirm(AppState.dialog_value); }
                                    self.armed = true; self.dragging = false;
                                    self.start-x = self.mouse-x;
                                    self.start-y = self.mouse-y - file-viewport.viewport-y;
                                    self.additive = event.modifiers.control || event.modifiers.shift;
                                    AppState.request-grid-marquee(0, 0, 0, 0, 0, file-list.columns, self.additive);
                                    if self.hover-row >= 0 && self.hover-row < AppState.files.length {
                                        if event.modifiers.control { AppState.request_toggle(self.hover-row); }
                                        else if event.modifiers.shift { AppState.request_range(self.hover-row); }
                                        else { AppState.request_select(self.hover-row); }
                                    } else if !self.additive { AppState.request_clear_selection(); }
                                }
                            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                                self.finish(false);
                            } else if event.kind == PointerEventKind.cancel { self.finish(true); }
                        }
                        moved => {
                            if self.armed && self.pressed {
                                if Math.abs(self.mouse-x - self.start-x) > 4px || Math.abs(self.mouse-y - file-viewport.viewport-y - self.start-y) > 4px { self.dragging = true; }
                                self.update-band();
                            }
                        }
                        double-clicked => {
                            if self.hover-row >= 0 && self.hover-row < AppState.files.length { AppState.request_activate(self.hover-row); }
                        }
                        scroll-event(event) => {
                            file-viewport.viewport-y = Math.clamp(file-viewport.viewport-y + event.delta-y, Math.min(0px, file-viewport.height - file-viewport.viewport-height), 0px);
                            self.update-band();
                            accept
                        }
                    }
                    Timer {
                        interval: 40ms;
                        running: marquee.armed && marquee.dragging && (marquee.mouse-y < 24px || marquee.mouse-y > marquee.height - 24px);
                        triggered => {
                            file-viewport.viewport-y = Math.clamp(file-viewport.viewport-y + (marquee.mouse-y < 24px ? Metrics.row-height : -Metrics.row-height), Math.min(0px, file-viewport.height - file-viewport.viewport-height), 0px);
                            marquee.update-band();
                        }
                    }
                    Rectangle {
                        visible: marquee.dragging;
                        x: Math.clamp(Math.min(marquee.start-x, marquee.mouse-x), 0px, marquee.width);
                        y: Math.clamp(Math.min(marquee.start-y + file-viewport.viewport-y, marquee.mouse-y), 0px, marquee.height);
                        width: Math.max(1px, Math.clamp(Math.max(marquee.start-x, marquee.mouse-x), 0px, marquee.width) - self.x);
                        height: Math.max(1px, Math.clamp(Math.max(marquee.start-y + file-viewport.viewport-y, marquee.mouse-y), 0px, marquee.height) - self.y);
                        background: Theme.accent.with-alpha(0.14);
                        border-width: 1px; border-color: Theme.accent;
                    }

                    inline-editor := InputField {
                        visible: AppState.inline-visible;
                        x: AppState.gallery ? Math.mod(AppState.inline-row, file-list.columns) * file-list.tile-width + 12px : 58px; y: Math.floor(AppState.inline-row / file-list.columns) * file-list.item-height + file-viewport.viewport-y + (AppState.gallery ? file-list.item-height - 56px : 0px);
                        width: AppState.gallery ? file-list.tile-width - 24px : Math.max(108px, file-list.name-width - 70px);
                        height: Metrics.row-height;
                        inline-mode: true; left-inset: 3px; right-inset: 3px;
                        border-radius: 2px;
                        text <=> AppState.dialog_value;
                        property <bool> focus-pending: false;
                        changed visible => { if self.visible { self.focus-pending = true; } }
                        Timer {
                            running: inline-editor.focus-pending; interval: 1ms;
                            triggered => {
                                inline-editor.focus-pending = false;
                                if inline-editor.y < 0px || inline-editor.y + Metrics.row-height > file-viewport.height {
                                    file-viewport.viewport-y = Math.clamp(-Math.floor(AppState.inline-row / file-list.columns) * file-list.item-height, Math.min(0px, file-viewport.height - file-viewport.viewport-height), 0px);
                                }
                                inline-editor.focus-name(AppState.inline-selection-end);
                            }
                        }
                        accepted => { AppState.request_dialog_confirm(AppState.dialog_value); if !AppState.inline-visible { list-scope.focus(); } }
                        cancelled => { AppState.request_dialog_cancel(); list-scope.focus(); }
                    }

                    // Empty and loading states, centered in the content area.
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        visible: AppState.files.length == 0;

                        VerticalLayout {
                            width: parent.width;
                            y: parent.height / 2 - 54px;
                            height: 108px;
                            spacing: Metrics.space-sm;
                            alignment: start;

                            Rectangle {
                                height: AppState.loading ? 0px : 44px;
                                visible: !AppState.loading;
                                IconEmptyFolder {
                                    width: 44px; height: 44px;
                                    x: (parent.width - self.width) / 2;
                                }
                            }

                            Text {
                                text: AppState.loading ? "Loading…" : (AppState.directory-error != "" ? "Can't open this folder" : (AppState.filtered-count > 0 ? "No visible items" : "This folder is empty"));
                                color: AppState.loading ? Theme.text-secondary : Theme.text-primary;
                                font-size: 13px;
                                font-weight: AppState.loading ? 400 : 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: 22px;
                            }

                            Text {
                                text: AppState.directory-error != "" ? AppState.directory-error : (AppState.filtered-count > 0 ? AppState.search-text != "" ? "No matches. Clear or adjust the search filters." : "Use View to show hidden or system files." : "Create a folder or paste files to get started.");
                                overflow: elide;
                                color: Theme.text-muted;
                                font-size: 11.5px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: 18px;
                                visible: !AppState.loading;
                            }
                        }
                    }
                }
            }
        }
    }

    // Status bar — full width, pinned to the bottom, same background as the
    // window so it stays visually quiet.
    statusbar := Rectangle {
        y: parent.height - Metrics.statusbar-height;
        x: 0;
        width: parent.width;
        height: Metrics.statusbar-height;
        background: Theme.window-bg;

        statusbar-nav := NavTouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
        }

        // Hairline separating the status bar from the content.
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 1px;
            background: Theme.border-subtle;
        }

        HorizontalLayout {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            padding-left: 20px;
            padding-right: 30px;
            spacing: Metrics.space-sm;

            Text {
                text: AppState.drive-overview ? AppState.drives.length + (AppState.drives.length == 1 ? " drive" : " drives") : AppState.item_count + (AppState.item_count == 1 ? " item" : " items") + (AppState.selected_count > 0 ? "  ·  " + AppState.selected_count + " selected" : "");
                color: Theme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            TextButton { width: 116px; height: 24px; text: AppState.transfer-count > 0 ? "Transfers (" + AppState.transfer-count + ")" : "Transfers"; accent: AppState.transfer-count > 0; clicked => { AppState.transfers-visible = !AppState.transfers-visible; } }
            Text {
                text: AppState.transfer-count > 0 ? AppState.transfer-summary : AppState.status_text == "Ready" ? AppState.selection-info : AppState.status_text;
                color: AppState.selected_count > 0 ? Theme.text-secondary : Theme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }

    if AppState.drive-overview: Rectangle {
        x: Metrics.sidebar-width;
        y: Metrics.tabs-height + Metrics.toolbar-height + Metrics.actions-height + Metrics.panel-gap;
        width: parent.width - Metrics.sidebar-width - Metrics.space-sm;
        height: parent.height - self.y - Metrics.statusbar-height;
        background: Theme.content-bg;
        NavTouchArea { }
        Rectangle {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height;
            border-radius: Metrics.radius-lg;
            background: Theme.content-bg;
            border-color: Theme.border-subtle; border-width: 1px;
            TouchArea { }
            home-focus := FocusScope {
                property <int> selected-drive: -1;
                property <bool> focus-pending: true;
                Timer { running: parent.focus-pending; interval: 1ms; triggered => { parent.focus-pending = false; home-focus.focus(); } }
                key-pressed(event) => {
                    if event.text == "l" && event.modifiers.control { address-field.focus-field(); address-field.select-all-text(); accept }
                    else if event.text == "t" && event.modifiers.control { AppState.request_new_tab(); accept }
                    else if event.text == "w" && event.modifiers.control { AppState.request_close_tab(AppState.active_tab); accept }
                    else if event.text == Key.F5 { AppState.request_refresh(); accept }
                    else if event.text == Key.LeftArrow && event.modifiers.alt && AppState.can_go_back { AppState.request_back(); accept }
                    else if event.text == Key.RightArrow && event.modifiers.alt && AppState.can_go_forward { AppState.request_forward(); accept }
                    else if event.text == Key.DownArrow { self.selected-drive = Math.min(AppState.drives.length - 1, self.selected-drive + 1); accept }
                    else if event.text == Key.UpArrow { self.selected-drive = Math.max(0, self.selected-drive - 1); accept }
                    else if event.text == Key.Return && self.selected-drive >= 0 && self.selected-drive < AppState.drives.length { AppState.request_navigate(AppState.drives[self.selected-drive].path); accept }
                    else { reject }
                }
            }
            Text { x: 20px; y: 12px; height: 38px; text: "Home"; color: Theme.text-primary; font-size: 22px; font-weight: 600; }
            Text { x: 20px; y: 52px; text: "Your folders and drives at a glance."; color: Theme.text-muted; font-size: 12px; }
            HorizontalLayout {
                x: 20px; y: 84px; width: parent.width - 40px; height: 44px; spacing: 8px;
                SidebarButton { text: "Desktop"; icon: AppState.desktop_icon; target: AppState.desktop_path; horizontal-stretch: 1; base-background: Theme.surface; }
                SidebarButton { text: "Documents"; icon: AppState.documents_icon; target: AppState.documents_path; horizontal-stretch: 1; base-background: Theme.surface; }
                SidebarButton { text: "Downloads"; icon: AppState.downloads_icon; target: AppState.downloads_path; horizontal-stretch: 1; base-background: Theme.surface; }
            }
            Text { x: 20px; y: 146px; height: 20px; text: AppState.drives-loading ? "Refreshing storage…" : "Devices and drives"; color: Theme.text-secondary; font-size: 12px; font-weight: 600; }
            HorizontalLayout {
                x: 20px; y: 182px; width: parent.width - 50px; height: 28px; spacing: 12px;
                Text { text: "Drive"; horizontal-stretch: 1; min-width: 150px; color: Theme.text-muted; font-size: 11px; }
                if root.width >= 1100px: Text { text: "File system"; width: 70px; color: Theme.text-muted; font-size: 11px; }
                Text { text: "Free"; width: 82px; horizontal-alignment: right; color: Theme.text-muted; font-size: 11px; }
                Text { text: "Total"; width: 82px; horizontal-alignment: right; color: Theme.text-muted; font-size: 11px; }
                Text { text: "Used"; width: root.width >= 1200px ? 240px : (root.width >= 1000px ? 180px : 100px); color: Theme.text-muted; font-size: 11px; }
            }
            ScrollView {
                x: 12px; y: 206px; width: parent.width - 24px; height: parent.height - 222px;
                viewport-width: self.width; viewport-height: AppState.drives.length * 48px;
                VerticalLayout {
                    spacing: 4px; padding-right: 10px;
                    for drive[drive-index] in AppState.drives: Rectangle {
                        height: 44px; border-radius: Metrics.radius-md;
                        background: home-focus.selected-drive == drive-index ? Theme.selection : (overview-drive-touch.has-hover ? Theme.surface-hover : Theme.surface);
                        HorizontalLayout {
                            padding: 8px; spacing: 12px;
                            HorizontalLayout {
                                horizontal-stretch: 1; min-width: 150px; spacing: 8px;
                                VerticalLayout { width: 22px; alignment: center; Image { source: drive.icon; width: 22px; height: 22px; } }
                                VerticalLayout { spacing: 1px; horizontal-stretch: 1;
                                    Text { text: drive.name; color: Theme.text-primary; font-size: 12px; overflow: elide; }
                                    Text { text: drive.drive-type; color: Theme.text-muted; font-size: 10px; }
                                }
                            }
                            if root.width >= 1100px: Text { text: drive.file-system; width: 70px; color: Theme.text-secondary; font-size: 12px; vertical-alignment: center; }
                            Text { text: drive.free-text; width: 82px; color: Theme.text-secondary; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                            Text { text: drive.total-text; width: 82px; color: Theme.text-secondary; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; }
                            Rectangle {
                                width: root.width >= 1200px ? 240px : (root.width >= 1000px ? 180px : 100px); height: 24px;
                                background: Theme.window-bg; border-radius: Metrics.radius-sm;
                                property <bool> revealed: !AppState.animations;
                                Timer { running: !parent.revealed; interval: 40ms; triggered => { parent.revealed = true; } }
                                Rectangle {
                                    x: 2px; y: 2px; height: parent.height - 4px;
                                    width: parent.revealed ? (parent.width - 4px) * Math.clamp(drive.usage, 0, 1) : 0px;
                                    border-radius: 3px; background: drive.usage > 0.9 ? Theme.danger : Theme.accent;
                                    animate width { duration: AppState.animations ? 500ms : 0ms; easing: ease-out; }
                                }
                                Text { text: drive.used-text; color: drive.usage > 0.5 ? Theme.window-bg : Theme.text-primary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        ContextMenuArea {
                            Menu {
                                MenuItem { title: "Open"; activated => { AppState.request_navigate(drive.path); } }
                                MenuItem { title: "Analyze storage"; activated => { AppState.request-analyze(drive.path); } }
                            }
                        overview-drive-touch := NavTouchArea { clicked => { home-focus.selected-drive = drive-index; home-focus.focus(); } double-clicked => { AppState.request_navigate(drive.path); } }
                        }
                    }
                }
            }
        }
    }

    if AppState.storage-visible: Rectangle {
        x: Metrics.sidebar-width; y: Metrics.tabs-height + Metrics.toolbar-height + Metrics.actions-height;
        width: parent.width - self.x - 8px; height: parent.height - self.y - Metrics.statusbar-height;
        background: Theme.content-bg;
        NavTouchArea { }
        storage-focus := FocusScope {
            property <bool> pending: true;
            Timer { running: parent.pending; interval: 1ms; triggered => { parent.pending = false; storage-focus.focus(); } }
            key-pressed(event) => { if event.text == Key.Escape { AppState.cancel-analysis(); AppState.storage-visible = false; list-scope.focus(); accept } else { reject } }
        }
        Text { x: 24px; y: 18px; text: "Storage analysis"; color: Theme.text-primary; font-size: 22px; font-weight: 600; }
        Text { x: 24px; y: 54px; width: parent.width - 48px; text: AppState.storage-path; color: Theme.text-muted; font-size: 12px; overflow: elide; }
        TextButton { x: parent.width - 116px; y: 18px; text: "Close"; clicked => { AppState.cancel-analysis(); AppState.storage-visible = false; list-scope.focus(); } }
        TextButton { x: parent.width - 228px; y: 18px; text: AppState.storage-busy ? "Cancel scan" : "Scan again"; clicked => { if AppState.storage-busy { AppState.cancel-analysis(); } else { AppState.request-analyze(AppState.storage-path); } } }
        Text { x: 24px; y: 88px; text: AppState.storage-total; color: Theme.accent; font-size: 28px; font-weight: 600; }
        Text { x: 24px; y: 128px; width: parent.width - 48px; text: AppState.storage-status; color: Theme.text-muted; font-size: 12px; overflow: elide; }
        Text { x: 24px; y: 162px; text: "Largest folders and files"; color: Theme.text-secondary; font-size: 13px; font-weight: 600; }
        ListView {
            x: 16px; y: 190px; width: parent.width - 32px; height: parent.height - self.y - 16px;
            for item in AppState.storage-items: Rectangle {
                height: 62px;
                background: storage-touch.has-hover ? Theme.surface-hover : transparent;
                Text { x: 8px; y: 5px; width: parent.width - 148px; text: item.name; color: Theme.text-primary; font-size: 13px; overflow: elide; }
                Text { x: parent.width - 138px; y: 5px; width: 112px; text: item.size; color: Theme.text-secondary; font-size: 12px; horizontal-alignment: right; }
                Text { x: 8px; y: 24px; width: parent.width - 36px; text: item.kind + " · " + item.path; color: Theme.text-muted; font-size: 10px; overflow: elide; }
                Rectangle { x: 8px; y: 44px; width: parent.width - 36px; height: 5px; border-radius: 2px; background: Theme.surface;
                    Rectangle { x: 0; y: 0; width: parent.width * item.fraction; height: parent.height; border-radius: 2px; background: item.kind == "Folder" ? Theme.accent : Theme.accent.with-alpha(0.5); }
                }
                storage-touch := NavTouchArea { double-clicked => { if item.kind == "Folder" { AppState.cancel-analysis(); AppState.storage-visible = false; list-scope.focus(); AppState.request_navigate(item.path); } } }
            }
        }
    }

    if AppState.library-visible: Rectangle {
        background: #00000070;
        TouchArea { clicked => { AppState.library-visible = false; list-scope.focus(); } }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: Math.min(660px, parent.width - 48px); height: Math.min(540px, parent.height - 80px);
            background: Theme.content-bg; border-width: 1px; border-color: Theme.border; border-radius: 10px;
            TouchArea { }
            Text { x: 24px; y: 20px; text: "Collections & tags"; color: Theme.text-primary; font-size: 22px; font-weight: 600; }
            TextButton { x: parent.width - 96px; y: 16px; width: 72px; text: "Close"; clicked => { AppState.library-visible = false; list-scope.focus(); } }
            Text { x: 24px; y: 56px; text: AppState.selected_count + " selected. Organize references without moving files."; color: Theme.text-muted; font-size: 12px; }
            library-name := InputField {
                x: 24px; y: 88px; width: parent.width - 48px; height: 36px; placeholder: "New collection or tag name"; text <=> AppState.library-name;
                property <bool> pending: true;
                Timer { running: parent.pending; interval: 1ms; triggered => { parent.pending = false; library-name.focus-field(); } }
                accepted => { AppState.library-action(4, "", AppState.library-name); }
                cancelled => { AppState.library-visible = false; list-scope.focus(); list-scope.focus(); }
            }
            HorizontalLayout {
                x: 24px; y: 136px; width: parent.width - 48px; height: 34px; spacing: 8px;
                TextButton { text: "Create collection"; width: 144px; enabled: AppState.library-writable && AppState.library-name != ""; accent: true; clicked => { AppState.library-action(4, "", AppState.library-name); } }
                TextButton { text: "Apply tag"; enabled: AppState.library-writable && AppState.library-name != ""; clicked => { AppState.library-action(5, "", AppState.library-name); } }
                TextButton { text: "Pin folder"; enabled: AppState.library-writable; clicked => { AppState.library-action(0, "", ""); } }
                Rectangle { horizontal-stretch: 1; }
            }
            Text { x: 24px; y: 180px; width: parent.width - 48px; text: AppState.library-error; color: Theme.danger; font-size: 12px; wrap: word-wrap; }
            ListView {
                x: 24px; y: 214px; width: parent.width - 48px; height: parent.height - self.y - 62px;
                for group in AppState.library-groups: Rectangle {
                    height: 48px;
                    Text { x: 0; y: 6px; width: parent.width - 228px; text: (group.tag ? "# " : "") + group.name; color: Theme.text-primary; font-size: 13px; overflow: elide; }
                    Text { x: 0; y: 26px; text: group.count + " references"; color: Theme.text-muted; font-size: 11px; }
                    TextButton { x: parent.width - 222px; y: 7px; width: 70px; text: "Open"; clicked => { AppState.library-action(6, group.key, ""); } }
                    TextButton { x: parent.width - 146px; y: 7px; width: 66px; text: "Add"; enabled: AppState.selected_count > 0 && AppState.library-writable; clicked => { AppState.library-action(group.tag ? 5 : 4, "", group.name); } }
                    TextButton { x: parent.width - 74px; y: 7px; width: 60px; text: "Remove"; enabled: AppState.library-writable; clicked => { AppState.library-action(7, group.key, ""); } }
                }
            }
            TextButton { x: 24px; y: parent.height - 48px; width: 226px; text: "Remove selected references"; enabled: !AppState.filesystem-location && !AppState.drive-overview && AppState.selected_count > 0 && AppState.library-writable; clicked => { AppState.library-action(8, "", ""); } }
        }
    }

    if AppState.transfers-visible: Rectangle {
        background: #00000040;
        TouchArea { clicked => { AppState.transfers-visible = false; list-scope.focus(); } }
        Rectangle {
            x: parent.width - self.width - 16px; y: parent.height - self.height - 44px;
            width: Math.min(640px, parent.width - 40px); height: Math.min(540px, parent.height - 100px);
            background: Theme.content-bg; border-width: 1px; border-color: Theme.border; border-radius: 9px;
            TouchArea { }
            transfer-focus := FocusScope {
                property <bool> pending: true;
                Timer { running: parent.pending; interval: 1ms; triggered => { parent.pending = false; transfer-focus.focus(); } }
                key-pressed(event) => { if event.text == Key.Escape { AppState.transfers-visible = false; list-scope.focus(); accept } else { reject } }
            }
            Text { x: 20px; y: 20px; text: "Transfers"; color: Theme.text-primary; font-size: 22px; font-weight: 600; }
            TextButton { x: parent.width - 212px; y: 18px; width: 108px; text: "Clear finished"; clicked => { AppState.clear-transfers(); } }
            TextButton { x: parent.width - 96px; y: 18px; width: 76px; text: "Close"; clicked => { AppState.transfers-visible = false; list-scope.focus(); } }
            if AppState.transfers.length == 0: Text { x: 20px; y: 86px; text: "Copy, move and delete operations appear here."; color: Theme.text-muted; font-size: 13px; }
            ListView {
                x: 14px; y: 70px; width: parent.width - 28px; height: parent.height - 84px;
                for item in AppState.transfers: Rectangle {
                    height: item.error != "" ? 186px : 162px;
                    Rectangle { x: 0; y: 2px; width: parent.width - 14px; height: parent.height - 10px; border-radius: 6px; background: Theme.surface; }
                    Text { x: 12px; y: 12px; text: item.title + " - " + item.status; color: Theme.text-primary; font-size: 13px; font-weight: 600; }
                    if item.running: TextButton { x: parent.width - 102px; y: 8px; width: 72px; height: 28px; text: "Cancel"; clicked => { AppState.cancel-transfer(item.id); } }
                    Text { x: 12px; y: 42px; width: parent.width - 44px; text: "From: " + item.source; color: Theme.text-muted; font-size: 11px; overflow: elide; }
                    Text { x: 12px; y: 60px; width: parent.width - 44px; text: "To: " + item.destination; color: Theme.text-muted; font-size: 11px; overflow: elide; }
                    Text { x: 12px; y: 80px; width: parent.width - 44px; text: item.current; color: Theme.text-secondary; font-size: 11px; overflow: elide; }
                    Rectangle { x: 12px; y: 108px; width: parent.width - 44px; height: 5px; border-radius: 2px; background: Theme.window-bg;
                        Rectangle { x: 0; y: 0; width: parent.width * item.progress; height: parent.height; border-radius: 2px; background: Theme.accent; visible: item.has-progress; }
                    }
                    Text { x: 12px; y: 124px; width: parent.width - 44px; text: item.detail; color: Theme.text-muted; font-size: 11px; overflow: elide; }
                    if item.error != "": Text { x: 12px; y: 148px; width: parent.width - 44px; text: item.error; color: Theme.danger; font-size: 11px; overflow: elide; }
                }
            }
        }
    }
    if AppState.conflict-visible: Rectangle {
        background: #00000080;
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: Math.min(720px, parent.width - 48px); height: 360px;
            background: Theme.content-bg; border-width: 1px; border-color: Theme.border; border-radius: 10px;
            conflict-focus := FocusScope {
                property <bool> pending: true;
                Timer { running: parent.pending; interval: 1ms; triggered => { parent.pending = false; conflict-focus.focus(); } }
                key-pressed(event) => { if event.text == Key.Escape { AppState.resolve-conflict(3, false); list-scope.focus(); accept } else { reject } }
            }
            Text { x: 24px; y: 22px; text: "A file with this name already exists"; color: Theme.text-primary; font-size: 21px; font-weight: 600; }
            Text { x: 24px; y: 60px; text: "Choose what to keep. Nothing is overwritten until you choose Replace."; color: Theme.text-muted; font-size: 12px; }
            for label[index] in ["Existing", "Incoming"]: Rectangle {
                x: 24px + index * ((parent.width - 60px) / 2 + 12px); y: 100px;
                width: (parent.width - 60px) / 2; height: 140px; border-radius: 6px; background: Theme.surface;
                Text { x: 14px; y: 12px; text: label; color: index == 1 ? Theme.accent : Theme.text-secondary; font-weight: 600; font-size: 13px; }
                Text { x: 14px; y: 40px; width: parent.width - 28px; height: 48px; text: index == 0 ? AppState.conflict-existing : AppState.conflict-incoming; color: Theme.text-primary; font-size: 12px; wrap: word-wrap; overflow: elide; }
                Text { x: 14px; y: 100px; width: parent.width - 28px; text: index == 0 ? AppState.conflict-existing-info : AppState.conflict-incoming-info; color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }
            }
            CheckBox { x: 24px; y: 256px; text: "Apply to all file conflicts in this operation"; checked <=> AppState.conflict-all; }
            HorizontalLayout {
                x: 24px; y: 304px; width: parent.width - 48px; height: 34px; spacing: 10px;
                TextButton { text: "Cancel"; clicked => { AppState.resolve-conflict(3, false); list-scope.focus(); } }
                Rectangle { horizontal-stretch: 1; }
                TextButton { text: "Skip"; clicked => { AppState.resolve-conflict(1, AppState.conflict-all); list-scope.focus(); } }
                TextButton { text: "Keep Both"; accent: true; clicked => { AppState.resolve-conflict(2, AppState.conflict-all); list-scope.focus(); } }
                TextButton { text: "Replace"; clicked => { AppState.resolve-conflict(0, AppState.conflict-all); list-scope.focus(); } }
            }
        }
    }

    NameDialog { changed visible => { if !self.visible { list-scope.focus(); } } }
    Rectangle { background: transparent; border-width: root.window-maximized ? 0px : 1px; border-color: Theme.border; }
    Path { x: root.width - 18px; y: root.height - 18px; width: 12px; height: 12px; viewbox-width: 12; viewbox-height: 12; commands: "M2 10L10 2M6 10L10 6M10 10L11 9"; fill: transparent; stroke: Theme.text-muted; stroke-width: 1px; visible: !root.window-maximized; }
    ResizeEdge { x: 16px; y: 0; width: root.width - 32px; height: 7px; direction: 0; enabled: !root.window-maximized; resize(d) => { root.resize-window(d); } }
    ResizeEdge { x: root.width - 7px; y: 16px; width: 7px; height: root.height - 32px; direction: 2; enabled: !root.window-maximized; resize(d) => { root.resize-window(d); } }
    ResizeEdge { x: 16px; y: root.height - 7px; width: root.width - 32px; height: 7px; direction: 4; enabled: !root.window-maximized; resize(d) => { root.resize-window(d); } }
    ResizeEdge { x: 0; y: 16px; width: 7px; height: root.height - 32px; direction: 6; enabled: !root.window-maximized; resize(d) => { root.resize-window(d); } }
    ResizeEdge { x: root.width - 16px; y: 0; width: 16px; height: 16px; direction: 1; enabled: !root.window-maximized; resize(d) => { root.resize-window(d); } }
    ResizeEdge { x: root.width - 20px; y: root.height - 20px; width: 20px; height: 20px; direction: 3; enabled: !root.window-maximized; resize(d) => { root.resize-window(d); } }
    ResizeEdge { x: 0; y: root.height - 16px; width: 16px; height: 16px; direction: 5; enabled: !root.window-maximized; resize(d) => { root.resize-window(d); } }
    ResizeEdge { x: 0; y: 0; width: 16px; height: 16px; direction: 7; enabled: !root.window-maximized; resize(d) => { root.resize-window(d); } }
}

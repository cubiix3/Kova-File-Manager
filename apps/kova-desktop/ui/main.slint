import { FilesNavBack, FilesNavForward, FilesNavUp, FilesRefresh, FilesCut, FilesCopy, FilesPaste, FilesRename, FilesDelete } from "files-icons.slint";
import { ListView, ScrollView, CheckBox } from "std-widgets.slint";

// Theme tokens — central place for colors and metrics.
export global Theme {
    out property <color> window-bg: #20262c;
    // Raised fill used by the address bar and other inset controls.
    out property <color> surface: #262d34;
    out property <color> surface-alt: #2c343d;
    out property <color> surface-hover: #303943;
    out property <color> surface-pressed: #3a4652;
    out property <color> sidebar-bg: #242b32;
    out property <color> sidebar-selected: #293d4a;
    out property <color> sidebar-hover: #2b343d;
    out property <color> selection: #2e4053;
    out property <color> selection-strong: #374e65;
    out property <color> border: #434c55;
    out property <color> border-subtle: #39424b;
    out property <color> text-primary: #f2f2f4;
    out property <color> text-secondary: #c5cbd1;
    out property <color> text-muted: #a7afb8;
    out property <color> text-disabled: #73808b;
    out property <color> accent: #75c5ee;
    out property <color> danger: #e5534b;
    out property <color> content-bg: #252c33;
    out property <color> tabs-bg: #1b2127;
    out property <color> shadow: #00000066;
}

export struct Breadcrumb { label: string, path: string }
export struct InfoItem { label: string, value: string }
export struct StorageItem { name: string, path: string, kind: string, size: string, fraction: float }
export struct LibraryItem { name: string, key: string, count: int, tag: bool }
export struct TransferItem { id: int, title: string, source: string, destination: string, current: string, status: string, progress: float, has-progress: bool, detail: string, error: string, running: bool }

export struct FileListItem {
    name: string,
    type_name: string,
    size_text: string,
    modified_text: string,
    icon-id: int,
    thumbnail: image,
    has-thumbnail: bool,
    is-dir: bool,
    selected: bool,
}

export struct DriveItem {
    name: string,
    path: string,
    icon: image,
    // Fraction of the drive in use, 0..1 (0 when unknown).
    usage: float,
    // e.g. "120 GB free of 476 GB"; empty when unknown.
    detail: string,
    file-system: string,
    drive-type: string,
    total-text: string,
    free-text: string,
    used-text: string,
    capacity-known: bool,
}

